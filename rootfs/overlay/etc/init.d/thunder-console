#!/usr/bin/openrc-run
# Sessao grafica do perfil console: phoc (compositor) com squeekboard e foot, como
# console_user (/etc/conf.d/thunder-console), em barramento D-Bus de sessao proprio.
# O seatd entrega DRM e entrada sem logind; o udev marca o toque (ID_INPUT_TOUCHSCREEN).
#
# command_user: o openrc 0.64.1 instala /etc/pam.d/supervise-daemon (auth/account
# pam_permit), entao o pam_start do supervise-daemon passa. A confirmar no aparelho
# (PLAN.md, passo 12): "pam error" no log do boot significa que o arquivo sumiu da imagem.

description="Sessao grafica (phoc + squeekboard + foot)"

: "${console_user:=}"
: "${console_renderer:=}"
: "${console_phoc_config:=/etc/phoc/thunder-console.ini}"

command=/usr/bin/dbus-run-session
supervisor=supervise-daemon
respawn_delay=3
respawn_max=5
respawn_period=60
retry="TERM/10/KILL/5"
# O supervise-daemon faz setsid no filho: --stop-group manda o TERM a dbus-run-session,
# dbus-daemon, phoc, console-session, squeekboard e foot de uma vez. O pkill do stop_post
# fica como reserva.
stopgroup=yes
logfile=/var/log/thunder-console.log
output_log=$logfile
error_log=$logfile

depend() {
	need localmount seatd udev-trigger
	after modules wifi-thunder
}

# Usuario da sessao: o do conf.d, ou o primeiro uid comum do /etc/passwd.
_console_user() {
	if [ -n "$console_user" ]; then
		echo "$console_user"
	else
		getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1; exit }'
	fi
}

start_pre() {
	user=$(_console_user)
	if [ -z "$user" ] || ! id "$user" >/dev/null 2>&1; then
		eerror "usuario da sessao nao encontrado (console_user em /etc/conf.d/thunder-console)"
		return 1
	fi
	uid=$(id -u "$user")
	gid=$(id -g "$user")
	if ! id -nG "$user" | tr ' ' '\n' | grep -qx seat; then
		ewarn "$user fora do grupo seat: o socket do seatd vai recusar"
	fi
	[ -S /run/seatd.sock ] || ewarn "/run/seatd.sock ausente (seatd subiu?)"

	# Sem logind nem tmpfiles na imagem, ninguem cria /run/user, e o checkpath nao cria pais.
	checkpath -d -m 0755 -o root:root /run/user || return 1
	checkpath -d -m 0700 -o "$uid:$gid" "/run/user/$uid" || return 1
	# O supervise-daemon abre o log depois de largar o root.
	checkpath -f -m 0644 -o "$uid:$gid" "$logfile" || return 1

	command_user="$user"
	# exportadas aqui herdam do openrc-run para o supervise-daemon e dai para o phoc
	export XDG_RUNTIME_DIR="/run/user/$uid"
	export LIBSEAT_BACKEND=seatd
	[ -n "$console_renderer" ] && export WLR_RENDERER="$console_renderer"

	cfg=
	[ -r "$console_phoc_config" ] && cfg="-C $console_phoc_config"
	command_args="-- /usr/bin/phoc --no-xwayland $cfg -E /usr/lib/thunder/console-session"
}

# Parar o dbus-run-session com TERM deixa o dbus-daemon e os clientes orfaos.
stop_post() {
	user=$(_console_user)
	[ -n "$user" ] || return 0
	pkill -TERM -u "$user" -x 'phoc|squeekboard|foot' 2>/dev/null
	pkill -TERM -u "$user" -f 'dbus-daemon.*--print-address' 2>/dev/null
	sleep 1
	pkill -KILL -u "$user" -x 'phoc|squeekboard|foot' 2>/dev/null
	return 0
}
