#!/usr/bin/openrc-run
# systemd-udevd 262 do proprio Arch como servico do OpenRC (sem logind, sem systemd).
# Grava o banco /run/udev/data que o libinput/wlroots exigem (ID_INPUT*), aplica as regras de
# permissao e entrega o hotplug pelo netlink. Precisa dos backports de kernel statx mount id,
# waitid(P_PIDFD) e close_range (PLAN.md passos 1-3).
# Modelo: eudev-openrc da Alpine (aports main/eudev, eudev.initd) e udev-openrc da Artix
# (udev.initd): provide dev, before checkfs fsck, daemon em primeiro plano.
# Diferencas: o 262 nao tem mais --daemon, entao o supervise-daemon e quem segura o processo;
# e o udevd e o do systemd, com socket de controle em /run/udev/control.
# Nomes de rede: o 80-net-setup-link.rules esta mascarado em /etc/udev/rules.d (symlink para
# /dev/null). Ele e o unico que chama o builtin net_setup_link, entao o 99-default.link
# (NamePolicy, MACAddressPolicy=persistent) nunca roda; usb0/rndis0/wlan0 ficam como o kernel
# nomeou. CONFIRMAR NO APARELHO (PLAN.md passo 4/5): `ip -br link` igual ao de antes.

description="systemd-udevd (gerenciador de dispositivos)"

: "${udev_opts:=}"
# Log do udevd (stdout e stderr). Em /run porque no sysinit o / pode estar so-leitura e o /var
# ainda nao montado; /run e tmpfs e some no reboot. Sem isso o supervise-daemon manda a saida
# do filho para /dev/null e nenhum erro do udevd aparece (o 262 loga em stderr fora do PID 1).
: "${udev_log:=/run/udevd.log}"

command=/usr/lib/systemd/systemd-udevd
command_args="${udev_opts}"
supervisor=supervise-daemon
# O rc_logger nao captura filho supervisionado; so output_log/error_log (como no seatd).
output_log="${udev_log}"
error_log="${udev_log}"
# SIGTERM e o desligamento limpo do udevd (ele espera os workers). Nao usar
# `udevadm control --exit` no stop: o supervise-daemon veria o filho sair e o respawnaria.
retry="TERM/10/KILL/5"

depend() {
	provide dev
	need sysfs dev-mount
	before checkfs fsck
	keyword -docker -lxc -prefix -systemd-nspawn -vserver
}

start_pre() {
	# O udevd cria /run/udev sozinho, mas o /run tem de existir e o binario ser o udevd real
	# (o link do pacote systemd-libs aponta para o udevadm).
	checkpath -f -m 0600 "${udev_log}" || return 1
	[ -x "$command" ] || { eerror "$command nao encontrado"; return 1; }
	# Controle de grupos: sob o OpenRC o servico cai em /sys/fs/cgroup/openrc.udev (ou no
	# cgroup do rc_cgroup_mode). O udevd 262 tenta criar um irmao "workers" para os workers
	# (udev-manager.c:1444-1466); se falhar so loga e segue. CONFIRMAR no aparelho: em
	# /run/udevd.log (udev_log; com udev_opts=--debug em /etc/conf.d/udev) nao pode haver erro
	# fatal de cgroup, "Event loop failed", EUNATCH nem falha de close_range.
	return 0
}

start_post() {
	# O supervise-daemon volta assim que faz o fork; o udev-trigger so pode rodar com o socket
	# de controle no ar, senao o udevadm falha com "Connection refused/No such file".
	local i=0
	while [ $i -lt 50 ]; do
		[ -S /run/udev/control ] && return 0
		sleep 0.1
		i=$((i + 1))
	done
	ewarn "udevd subiu sem /run/udev/control em 5s"
	return 0
}
