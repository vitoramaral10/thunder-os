#!/usr/bin/openrc-run
# wpa_supplicant na interface Wi-Fi do aparelho (WIFI_INTERFACE no device.sh, gravada
# em /etc/conf.d/wpa-supplicant). As redes ficam em
# /etc/wpa_supplicant/wpa_supplicant-<iface>.conf; thunder-wifi conecta e esquece.
#
# Sem udev: a interface pode nascer depois do boot (bring-up do aparelho, servico que
# fornece wifi-hw), entao o start espera por ela.
#
# wpa_mac="stable" (padrao): MAC fixo, derivado do machine-id desta instalacao e marcado
# como localmente administrado. Drivers que sorteiam o MAC a cada boot (o gen4m do
# thunder sem NVRAM) fariam o roteador dar outro IP toda vez. wpa_mac="keep" deixa o
# do driver.

description="wpa_supplicant (Wi-Fi)"

: "${wpa_iface:=wlan0}"
: "${wpa_wait:=60}"
: "${wpa_mac:=stable}"
conf=/etc/wpa_supplicant/wpa_supplicant-${wpa_iface}.conf

command=/usr/bin/wpa_supplicant
command_args="-D nl80211 -i ${wpa_iface} -c ${conf} -s"
supervisor=supervise-daemon

depend() {
	need localmount
	use wifi-hw
	after wifi-hw
}

start_pre() {
	if [ ! -s "$conf" ]; then
		mkdir -p /etc/wpa_supplicant
		printf 'ctrl_interface=DIR=/run/wpa_supplicant GROUP=wheel\nupdate_config=1\n' > "$conf"
		chmod 600 "$conf"
	fi
	i=0
	while [ ! -e "/sys/class/net/${wpa_iface}" ]; do
		i=$((i + 1))
		if [ "$i" -gt "$wpa_wait" ]; then
			eerror "${wpa_iface} nao apareceu em ${wpa_wait} s"
			return 1
		fi
		sleep 1
	done
	if [ "$wpa_mac" = stable ] && [ -s /etc/machine-id ]; then
		mac=02$(printf '%s' "$(cat /etc/machine-id)${wpa_iface}" | sha256sum |
			cut -c1-10 | sed 's/../:&/g')
		if [ "$(cat "/sys/class/net/${wpa_iface}/address")" != "$mac" ]; then
			ip link set "${wpa_iface}" down
			ip link set "${wpa_iface}" address "$mac" || ewarn "o driver recusou o MAC $mac"
		fi
	fi
	ip link set "${wpa_iface}" up
}
