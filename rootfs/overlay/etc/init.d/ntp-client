#!/usr/bin/openrc-run
# Hora pela rede com o ntpd do busybox. A cada ajuste grava tambem o RTC
# (/usr/lib/thunder/ntp-event), para o proximo boot ja comecar com a hora certa
# mesmo antes da rede: sem isso, um RTC que voltou para 2009 (bateria zerada) faz o
# OpenRC reclamar de clock skew e quebra TLS ate a rede subir.

description="Hora pela rede (busybox ntpd)"

: "${ntp_servers:=0.pool.ntp.org 1.pool.ntp.org 2.pool.ntp.org}"

command=/usr/bin/busybox
command_args="ntpd -n -S /usr/lib/thunder/ntp-event $(for s in ${ntp_servers}; do printf -- '-p %s ' "$s"; done)"
supervisor=supervise-daemon

depend() {
	use net dns
	after dhcpcd-wifi
}
