#!/usr/bin/openrc-run
# Saida de emergencia: telnet COM login, preso ao endereco do cabo USB (172.16.42.1).
# Existe porque SSH pelo RNDIS ja falhou neste aparelho com pacote TCP grande; nunca
# escuta no Wi-Fi.

description="Telnet com login, so no cabo USB"

command=/usr/bin/busybox
command_args="telnetd -F -b 172.16.42.1:23 -l /usr/bin/login"
command_background=yes
pidfile=/run/telnet-usb.pid

depend() {
	need usb-network
}
