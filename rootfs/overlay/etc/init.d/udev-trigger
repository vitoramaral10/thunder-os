#!/usr/bin/openrc-run
# Coldplug: reapresenta ao udevd os dispositivos que o kernel ja criou antes dele subir, para
# gerar /run/udev/data (ID_INPUT*), carregar modulos por modalias e aplicar permissoes.
# Modelo: udev-trigger da Alpine (eudev-openrc) e da Artix (udev-openrc): subsystems primeiro,
# devices depois, settle no fim.
# Roda no sysinit, antes do servico modules (boot). CONFIRMAR no aparelho (PLAN.md passo 5):
# tempo do settle (blkid nas particoes UFS), modulos que a modalias carregou (lsmod) e se
# algum driver MTK reage mal ao "add".

description="Coldplug do udev (trigger + settle)"

# Argumentos extras para os dois triggers; ex.: udev_trigger_args="--subsystem-nomatch=net"
# em /etc/conf.d/udev-trigger se o mask do net-setup-link nao bastar para manter os nomes.
: "${udev_trigger_args:=}"
: "${udev_settle_timeout:=60}"

depend() {
	need udev
}

start() {
	ebegin "Coldplug do udev"
	if [ ! -S /run/udev/control ]; then
		eend 1 "udevd sem socket de controle"
		return 1
	fi
	udevadm trigger --type=subsystems --action=add ${udev_trigger_args} &&
		udevadm trigger --type=devices --action=add ${udev_trigger_args}
	eend $?
	# Timeout do settle nao derruba o boot: o udevd segue processando em segundo plano.
	ebegin "Esperando a fila do udev"
	udevadm settle --timeout="${udev_settle_timeout}"
	eend $? "settle estourou ${udev_settle_timeout}s (o boot segue)"
	return 0
}
