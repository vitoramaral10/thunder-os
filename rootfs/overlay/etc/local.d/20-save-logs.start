#!/bin/sh
# Guarda o que explica um boot que deu errado: o pstore (console do boot anterior,
# sobrevive ao reboot) e o dmesg deste boot.
d=/var/log/thunder/$(date +%Y%m%d-%H%M%S)
mkdir -p "$d"
mkdir -p /sys/fs/pstore
mountpoint -q /sys/fs/pstore || mount -t pstore pstore /sys/fs/pstore 2>/dev/null
cp -a /sys/fs/pstore/. "$d/pstore/" 2>/dev/null
dmesg > "$d/dmesg.txt"
cp /proc/cmdline "$d/cmdline.txt"
# So os 20 boots mais recentes.
ls -1d /var/log/thunder/*/ 2>/dev/null | head -n -20 | xargs -r rm -rf
