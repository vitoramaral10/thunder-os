#!/bin/sh
# Chamado pelo ntpd do busybox (-S) com o evento em $1: "step" (hora corrigida de uma
# vez), "stratum" (mudou a fonte), "periodic" ou "unsync". Nos dois primeiros, o RTC
# recebe a hora do sistema.
case $1 in
step|stratum)
	hwclock --systohc --utc 2>/dev/null && echo "$(date) RTC acertado ($1)" >> /run/ntp-event.log
	;;
esac
exit 0
