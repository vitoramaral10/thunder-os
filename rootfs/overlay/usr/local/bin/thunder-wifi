#!/bin/bash
# Wi-Fi pelo terminal, sobre o wpa_supplicant do servico wpa-supplicant.
#
#   thunder-wifi scan              redes visiveis (sinal, faixa, nome)
#   thunder-wifi connect <rede>    pede a senha e conecta; a rede fica salva
#   thunder-wifi status            estado, rede, endereco IP
#   thunder-wifi forget <rede>     esquece a rede salva
#
# A senha nunca e gravada: so a chave derivada (PSK, wpa_passphrase). O nome da rede
# vai em hexadecimal, para nome com aspas, espacos ou acentos nao quebrar o arquivo.
set -euo pipefail

IFACE=${THUNDER_WIFI_IFACE:-wlan0}
[ -r /etc/conf.d/wpa-supplicant ] && . /etc/conf.d/wpa-supplicant
IFACE=${wpa_iface:-$IFACE}

wcli() { wpa_cli -i "$IFACE" "$@"; }

need_daemon() {
	wcli ping >/dev/null 2>&1 && return 0
	echo "o wpa_supplicant nao esta rodando em $IFACE: rc-service wpa-supplicant start" >&2
	exit 1
}

hex() { printf '%s' "$1" | od -An -tx1 | tr -d ' \n'; }

# O wpa_cli escapa o nome da rede (\xNN para acento e bytes nao imprimiveis, \" e \\).
# Devolve o nome real. \" primeiro: um \\ seguido de aspas sempre vem como \\\".
unescape() {
	local s=${1//\\\"/\"}
	printf '%b' "$s"
}

# id da rede salva com este nome (o nome real, sem escape), ou vazio.
network_id() {
	local id name _
	while IFS=$'\t' read -r id name _; do
		if [ "$(unescape "$name")" = "$1" ]; then
			echo "$id"
			return
		fi
	done < <(wcli list_networks | tail -n +2)
}

case ${1:-status} in
scan)
	need_daemon
	wcli scan >/dev/null
	sleep 6
	printf '%-6s %-7s %s\n' SINAL FAIXA REDE
	# bssid, freq, sinal, flags, nome (escapado pelo wpa_cli)
	wcli scan_results | tail -n +2 | sort -t$'\t' -k3 -n -r |
		while IFS=$'\t' read -r _ freq signal _ name; do
			[ -n "$name" ] || continue
			# Rede oculta anuncia o nome como bytes nulos: sem nome para escolher.
			case $name in *'\x00'*) continue ;; esac
			name=$(unescape "$name")
			# Nome com quebra de linha nao cabe nesta saida de uma linha por rede.
			case $name in *$'\n'*) continue ;; esac
			band=2.4GHz
			[ "$freq" -gt 4000 ] && band=5GHz
			printf '%-6s %-7s %s\n' "$signal" "$band" "$name"
		done | awk '!seen[$0]++'
	;;
connect)
	need_daemon
	ssid=${2:?uso: thunder-wifi connect <rede>}
	read -r -s -p "Senha de \"$ssid\" (vazio para rede aberta): " pass
	echo
	# A rede ja salva com esse nome so sai depois que a nova associar: senha errada
	# numa reconexao nao pode apagar a que funcionava.
	old=$(network_id "$ssid")
	id=$(wcli add_network | tail -n 1)
	wcli set_network "$id" ssid "$(hex "$ssid")" >/dev/null
	if [ -z "$pass" ]; then
		wcli set_network "$id" key_mgmt NONE >/dev/null
	else
		if [ ${#pass} -lt 8 ] || [ ${#pass} -gt 63 ]; then
			echo "senha WPA tem de 8 a 63 caracteres" >&2
			wcli remove_network "$id" >/dev/null
			exit 1
		fi
		# Senha pela entrada padrao: como argumento ela apareceria no ps.
		psk=$(printf '%s\n' "$pass" | wpa_passphrase "$ssid" | sed -n 's/^[[:space:]]*psk=//p')
		wcli set_network "$id" psk "$psk" >/dev/null
	fi
	unset pass
	wcli enable_network "$id" >/dev/null
	wcli select_network "$id" >/dev/null
	echo "conectando a \"$ssid\"..."
	for _ in $(seq 1 20); do
		sleep 1
		if wcli status | grep -q '^wpa_state=COMPLETED'; then
			[ -z "$old" ] || wcli remove_network "$old" >/dev/null
			# O select_network desativa as outras redes salvas; elas voltam a valer.
			wcli enable_network all >/dev/null
			wcli save_config >/dev/null
			echo "associado. Endereco IP pelo dhcpcd em alguns segundos: thunder-wifi status"
			exit 0
		fi
	done
	# Falhou: a rede nova sai, as salvas voltam, e nada errado fica gravado.
	wcli remove_network "$id" >/dev/null
	wcli enable_network all >/dev/null
	wcli save_config >/dev/null
	wcli reassociate >/dev/null
	echo "nao associou em 20 s: senha errada ou rede fora de alcance?" >&2
	exit 1
	;;
status)
	if ! wcli ping >/dev/null 2>&1; then
		echo "wpa_supplicant parado em $IFACE"
		exit 1
	fi
	wcli status | grep -E '^(wpa_state|ssid|freq|ip_address)=' || true
	ip -br addr show "$IFACE"
	;;
forget)
	need_daemon
	id=$(network_id "${2:?uso: thunder-wifi forget <rede>}")
	[ -n "$id" ] || { echo "nao ha rede salva com esse nome" >&2; exit 1; }
	wcli remove_network "$id" >/dev/null
	wcli save_config >/dev/null
	echo "esquecida"
	;;
*)
	sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
	exit 2
	;;
esac
