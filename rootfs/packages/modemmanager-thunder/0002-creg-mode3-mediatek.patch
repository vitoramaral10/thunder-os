thunder: aceitar o +CREG/+CEREG no modo 3 do 27.007 (modem MediaTek MT6833).

O MD responde no modo 3 mesmo depois de AT+CEREG=2, com AcT de dois digitos (13) e
cause_type,reject_cause no fim; nenhuma regex casava e o MM ficava em "unknown
registration status": modem enabled sem registro e connect com Network timeout.

--- a/src/mm-modem-helpers.c
+++ b/src/mm-modem-helpers.c
@@ -879,6 +879,12 @@
     [12] = "\\+(C5GREG):\\s*([0-9]+)\\s*,\\s*([^,\\s]*)\\s*,\\s*([^,\\s]*)\\s*,\\s*([0-9]+)\\s*,\\s*([^,\\s]*)\\s*,\\s*([^,\\s]*)",
     /* +C5GREG: <n>,<stat>,<lac>,<ci>,<AcT>,<Allowed_NSSAI_length>,<Allowed_NSSAI> (ETSI 27.007 solicited) */
     [13] = "\\+(C5GREG):\\s*([0-9]+)\\s*,\\s*([0-9+])\\s*,\\s*([^,\\s]*)\\s*,\\s*([^,\\s]*)\\s*,\\s*([0-9]+)\\s*,\\s*([^,\\s]*)\\s*,\\s*([^,\\s]*)",
+    /* +CEREG: <n>,<stat>,<lac>,<ci>,<AcT>,<cause_type>,<reject_cause> (27.007 CEREG=3 solicited).
+     * MediaTek modems keep answering in mode 3 even after AT+CEREG=2, with a two-digit AcT
+     * (13, E-UTRA-NR dual connectivity): '+CEREG: 3,1,"C80B","0C362C16",13,0,0' */
+    [14] = "\\+(CREG|CGREG|CEREG):\\s*0*([0-9]),\\s*0*([0-9])\\s*,\\s*([^,\\s]*)\\s*,\\s*([^,\\s]*)\\s*,\\s*0*([0-9]+)\\s*,\\s*[0-9]*\\s*,\\s*[0-9]*",
+    /* +CEREG: <stat>,<lac>,<ci>,<AcT>,<cause_type>,<reject_cause> (27.007 CEREG=3 unsolicited) */
+    [15] = "\\+(CREG|CGREG|CEREG):\\s*0*([0-9])\\s*,\\s*([^,\\s]*)\\s*,\\s*([^,\\s]*)\\s*,\\s*0*([0-9]+)\\s*,\\s*[0-9]*\\s*,\\s*[0-9]*",
 };
 
