+#include "mm-iface-modem.h"
+#include "mm-iface-modem-voice.h"
+#include "mm-log-object.h"
+#include "mm-modem-helpers.h"
+#include "mm-modem-helpers-mtk-ccci.h"
+#include "mm-port-serial-at.h"
+
+static void iface_modem_init       (MMIfaceModemInterface      *iface);
+static void iface_modem_voice_init (MMIfaceModemVoiceInterface *iface);
+
+static MMIfaceModemInterface      *iface_modem_parent;
+static MMIfaceModemVoiceInterface *iface_modem_voice_parent;
+
+struct _MMBroadbandModemMtkCcciPrivate {
+    GRegex     *eif_regex;
+    GRegex     *ecpi_regex;
+    GPtrArray  *ignored_regexes;
+    /* cid -> MMMtkCcciEifInfo of the last "ifup" not yet followed by "ifdown" */
+    GHashTable *active_pdns;
+    guint       call_list_reload_id;
+};
+
+G_DEFINE_TYPE_EXTENDED (MMBroadbandModemMtkCcci, mm_broadband_modem_mtk_ccci, MM_TYPE_BROADBAND_MODEM, 0,
+                        G_ADD_PRIVATE (MMBroadbandModemMtkCcci)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM, iface_modem_init)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_VOICE, iface_modem_voice_init))
+
+enum {
+    SIGNAL_EIF,
+    SIGNAL_LAST
+};
+
+static guint signals[SIGNAL_LAST];
+
+/*****************************************************************************/
+/* URC regexes
+ *
+ * The MD sends many proprietary reports at any time, also in the middle of a
+ * command and its final result. Without a handler they end up in the
+ * response buffer and break the parsing of whatever command is pending, so
+ * every one known is registered and swallowed.
+ *
+ * A handler removes the leading CRLF and the line, but leaves the trailing
+ * CRLF in place: a final result that follows the report without a blank line
+ * ("\r\n+EIND: 1\r\nOK\r\n") still parses as "\r\nOK\r\n". A report at the
+ * very start of the buffer (left there by another handler) matches too.
+ */
+
+#define MTK_CCCI_URC_REGEX(tag) "(?:\\r\\n|^)\\+" tag ":[ \\t]*([^\\r\\n]*)(?=\\r\\n)"
+
+static const gchar *mtk_ccci_ignored_urcs[] = {
+    /* Measured on MOLY.NR15.R3.MP.V48.6.P51 (Redmi 10 5G) */
+    MTK_CCCI_URC_REGEX ("EIND"),
+    MTK_CCCI_URC_REGEX ("EIMSGEO"),
+    MTK_CCCI_URC_REGEX ("EWIFIRSSITHRCFG"),
+    MTK_CCCI_URC_REGEX ("ESIMIND"),
+    MTK_CCCI_URC_REGEX ("EUSIM"),
+    MTK_CCCI_URC_REGEX ("ECEMODE"),
+    MTK_CCCI_URC_REGEX ("CIREPI"),
+    MTK_CCCI_URC_REGEX ("CNEMS1"),
+    MTK_CCCI_URC_REGEX ("CEN1"),
+    MTK_CCCI_URC_REGEX ("CEN2"),
+    MTK_CCCI_URC_REGEX ("EDSBP"),
+    MTK_CCCI_URC_REGEX ("ESBPID"),
+    MTK_CCCI_URC_REGEX ("ESMLSTATUS"),
+    MTK_CCCI_URC_REGEX ("ECAPABILITY"),
+    MTK_CCCI_URC_REGEX ("EPDN"),
+    MTK_CCCI_URC_REGEX ("EACMT"),
+    MTK_CCCI_URC_REGEX ("EXCAPRCN"),
+    /* IMS family, seen on other MediaTek MDs by the mtk-soc fork */
+    MTK_CCCI_URC_REGEX ("EDMFAPP"),
+    MTK_CCCI_URC_REGEX ("CIREGU"),
+    MTK_CCCI_URC_REGEX ("CIREP"),
+    MTK_CCCI_URC_REGEX ("EIREG"),
+    MTK_CCCI_URC_REGEX ("EIMSCFG"),
+    MTK_CCCI_URC_REGEX ("EIMSUI"),
+    MTK_CCCI_URC_REGEX ("EIMSXUI"),
+    MTK_CCCI_URC_REGEX ("EIMSREGURI"),
+    MTK_CCCI_URC_REGEX ("EIMSREGRESP"),
+    MTK_CCCI_URC_REGEX ("EIMSPDIS"),
+    MTK_CCCI_URC_REGEX ("ESIPREGINFO"),
+    MTK_CCCI_URC_REGEX ("ENAPTR"),
+};
+
+static GRegex *
+mtk_ccci_regex_new (const gchar *pattern)
+{
+    GRegex *regex;
+
+    regex = g_regex_new (pattern, G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    g_assert (regex);
+    return regex;
+}
+
+/*****************************************************************************/
+/* +EIF: PDN <-> ccmni interface reports */
+
+static gboolean
+active_pdn_matches_interface (gpointer key,
+                              gpointer value,
+                              gpointer user_data)
+{
+    return mm_mtk_ccci_eif_same_interface (value, user_data);
+}
+
+static void
+eif_received (MMPortSerialAt          *port,
+              GMatchInfo              *match_info,
+              MMBroadbandModemMtkCcci *self)
+{
+    g_autofree gchar  *str = NULL;
+    g_autoptr(GError)  error = NULL;
+    MMMtkCcciEifInfo   info = { 0 };
+
+    str = g_match_info_fetch (match_info, 1);
+    if (!mm_mtk_ccci_parse_eif (str, &info, &error)) {
+        mm_obj_warn (self, "couldn't parse +EIF report: %s", error->message);
+        return;
+    }
+
+    if (info.has_cid)
+        mm_obj_info (self, "PDN interface report '%s' on ccmni%u (id %u, cid %u, ipv4 %s, ipv6 %s)",
+                     info.event_str, info.interface_index, info.trans_intf_id, info.cid,
+                     info.ipv4 ? info.ipv4 : "n/a", info.ipv6 ? info.ipv6 : "n/a");
+    else
+        mm_obj_info (self, "PDN interface report '%s' on ccmni%u (id %u)",
+                     info.event_str, info.interface_index, info.trans_intf_id);
+
+    switch (info.event) {
+    case MM_MTK_CCCI_EIF_EVENT_IFUP:
+        if (info.has_cid)
+            g_hash_table_replace (self->priv->active_pdns,
+                                  GUINT_TO_POINTER (info.cid),
+                                  mm_mtk_ccci_eif_info_dup (&info));
+        break;
+    case MM_MTK_CCCI_EIF_EVENT_IFDOWN:
+        g_hash_table_foreach_remove (self->priv->active_pdns, active_pdn_matches_interface, &info);
+        break;
+    case MM_MTK_CCCI_EIF_EVENT_IFCHG:
+        /* Interface kept (e.g. CS fallback while in a call): nothing to do */
+        break;
+    case MM_MTK_CCCI_EIF_EVENT_UNKNOWN:
+    default:
+        break;
+    }
+
+    g_signal_emit (self, signals[SIGNAL_EIF], 0, &info);
+    mm_mtk_ccci_eif_info_clear (&info);
+}
+
+const MMMtkCcciEifInfo *
+mm_broadband_modem_mtk_ccci_peek_active_pdn (MMBroadbandModemMtkCcci *self,
+                                             guint                    cid)
+{
+    return g_hash_table_lookup (self->priv->active_pdns, GUINT_TO_POINTER (cid));
+}
+
+/*****************************************************************************/
+/* Setup ports (Broadband modem class) */
+
+static void
+setup_ports (MMBroadbandModem *_self)
+{
+    MMBroadbandModemMtkCcci *self = MM_BROADBAND_MODEM_MTK_CCCI (_self);
+    MMPortSerialAt          *primary;
+    g_autoptr(GRegex)        cgev_regex = NULL;
+    guint                    i;
+
+    /* Call parent's setup ports first always */
+    MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_mtk_ccci_parent_class)->setup_ports (_self);
+
+    primary = mm_base_modem_peek_port_primary (MM_BASE_MODEM (self));
+    if (!primary) {
+        mm_obj_warn (self, "no primary AT port: MediaTek URC handlers not set");
+        return;
+    }
+
+    /* CCCI is message based: every write() becomes one packet to the MD, so
+     * send each command in a single write, like the stock RIL does, instead
+     * of byte by byte. */
+    g_object_set (primary, MM_PORT_SERIAL_SEND_DELAY, (guint64) 0, NULL);
+
+    for (i = 0; i < self->priv->ignored_regexes->len; i++)
+        mm_port_serial_at_add_unsolicited_msg_handler (primary,
+                                                       g_ptr_array_index (self->priv->ignored_regexes, i),
+                                                       NULL, NULL, NULL);
+
+    /* +CGEV and +ECPI are swallowed until the generic 3GPP code and our voice
+     * support install their real handlers; both use the very same patterns
+     * so that those registrations replace these. */
+    cgev_regex = mm_3gpp_cgev_regex_get ();
+    mm_port_serial_at_add_unsolicited_msg_handler (primary, cgev_regex, NULL, NULL, NULL);
+    mm_port_serial_at_add_unsolicited_msg_handler (primary, self->priv->ecpi_regex, NULL, NULL, NULL);
+
+    /* +EIF is always tracked: it binds PDP contexts to ccmni interfaces */
+    mm_port_serial_at_add_unsolicited_msg_handler (primary,
+                                                   self->priv->eif_regex,
+                                                   (MMPortSerialAtUnsolicitedMsgFn) eif_received,
+                                                   self,
+                                                   NULL);
+
+    mm_obj_dbg (self, "registered %u MediaTek URC handlers in %s",
+                self->priv->ignored_regexes->len + 3,
+                mm_port_get_device (MM_PORT (primary)));
+}
+
+/*****************************************************************************/
+/* Initialization started (Broadband modem class)
+ *
+ * The MD comes up at +CFUN: 0, where the SIM is not powered and +CPIN?
+ * fails, which would leave the modem in the failed state. Power it up before
+ * the generic initialization looks at the SIM. Best effort: errors are only
+ * logged. The parent opens the primary port, so it runs first.
+ */
+
+static gpointer
+initialization_started_finish (MMBroadbandModem  *self,
+                               GAsyncResult      *res,
+                               GError           **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+initialization_complete (GTask *task)
+{
+    /* The task data is the parent's started context; ownership goes to the
+     * caller, which hands it back to initialization_stopped() */
+    g_task_return_pointer (task, g_task_get_task_data (task), NULL);
+    g_object_unref (task);
+}
+
+static void
+cfun_set_ready (MMBaseModem  *self,
+                GAsyncResult *res,
+                GTask        *task)
+{
+    g_autoptr(GError) error = NULL;
+
+    if (!mm_base_modem_at_command_finish (self, res, &error))
+        mm_obj_warn (self, "couldn't power up the MD with +CFUN=1: %s", error->message);
+    initialization_complete (task);
+}
+
+static void
+cfun_query_ready (MMBaseModem  *self,
+                  GAsyncResult *res,
+                  GTask        *task)
+{
+    g_autoptr(GError)  error = NULL;
+    const gchar       *response;
+    guint              state;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response) {
+        mm_obj_warn (self, "couldn't query +CFUN: %s", error->message);
+        initialization_complete (task);
+        return;
+    }
+
+    if (!mm_3gpp_parse_cfun_query_response (response, &state, &error)) {
+        mm_obj_warn (self, "couldn't parse +CFUN response: %s", error->message);
+        initialization_complete (task);
+        return;
+    }
+
+    if (state == 1) {
+        initialization_complete (task);
+        return;
+    }
+
+    mm_obj_info (self, "MD radio is off (+CFUN: %u); powering it up before initialization", state);
+    mm_base_modem_at_command (self, "+CFUN=1", 15, FALSE,
+                              (GAsyncReadyCallback) cfun_set_ready, task);
+}
+
+static void
+parent_initialization_started_ready (MMBroadbandModem *self,
+                                     GAsyncResult     *res,
+                                     GTask            *task)
+{
+    GError   *error = NULL;
+    gpointer  parent_ctx;
+
+    parent_ctx = MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_mtk_ccci_parent_class)->initialization_started_finish (self, res, &error);
+    if (error) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_set_task_data (task, parent_ctx, NULL);
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+CFUN?", 5, FALSE,
+                              (GAsyncReadyCallback) cfun_query_ready, task);
+}
+
+static void
+initialization_started (MMBroadbandModem    *self,
+                        GAsyncReadyCallback  callback,
+                        gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_mtk_ccci_parent_class)->initialization_started (
+        self,
+        (GAsyncReadyCallback) parent_initialization_started_ready,
+        task);
+}
+
+/*****************************************************************************/
+/* Power up (Modem interface)
+ *
+ * After the generic +CFUN=1, tell the MD that data is allowed on this SIM
+ * (AT+EDALLOW=1, what the stock RIL sends). Older MDs do not know it: any
+ * error is ignored.
+ */
+
+static gboolean
+modem_power_up_finish (MMIfaceModem  *self,
+                       GAsyncResult  *res,
+                       GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+edallow_ready (MMBaseModem  *self,
+               GAsyncResult *res,
+               GTask        *task)
+{
+    g_autoptr(GError) error = NULL;
+
+    if (!mm_base_modem_at_command_finish (self, res, &error))
+        mm_obj_dbg (self, "AT+EDALLOW=1 not accepted (ignored): %s", error->message);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+parent_modem_power_up_ready (MMIfaceModem *self,
+                             GAsyncResult *res,
+                             GTask        *task)
+{
+    GError *error = NULL;
+
+    if (!iface_modem_parent->modem_power_up_finish (self, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+EDALLOW=1", 5, FALSE,
+                              (GAsyncReadyCallback) edallow_ready, task);
+}
+
+static void
+modem_power_up (MMIfaceModem        *self,
+                GAsyncReadyCallback  callback,
+                gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    iface_modem_parent->modem_power_up (self,
+                                        (GAsyncReadyCallback) parent_modem_power_up_ready,
+                                        task);
+}
+
+/*****************************************************************************/
+/* Create bearer (Modem interface) */
+
+static MMBaseBearer *
+modem_create_bearer_finish (MMIfaceModem  *self,
+                            GAsyncResult  *res,
+                            GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+broadband_bearer_mtk_ccci_new_ready (GObject      *source,
+                                     GAsyncResult *res,
+                                     GTask        *task)
+{
+    MMBaseBearer *bearer;
+    GError       *error = NULL;
+
+    bearer = mm_broadband_bearer_mtk_ccci_new_finish (res, &error);
+    if (!bearer)
+        g_task_return_error (task, error);
+    else
+        g_task_return_pointer (task, bearer, g_object_unref);
+    g_object_unref (task);
+}
+
+static void
+modem_create_bearer (MMIfaceModem        *self,
+                     MMBearerProperties  *properties,
+                     GAsyncReadyCallback  callback,
+                     gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_broadband_bearer_mtk_ccci_new (MM_BROADBAND_MODEM_MTK_CCCI (self),
+                                      properties,
+                                      NULL, /* cancellable */
+                                      (GAsyncReadyCallback) broadband_bearer_mtk_ccci_new_ready,
+                                      task);
+}
+
+/*****************************************************************************/
+/* +ECPI: call progress (Voice interface) */
+
+static void
+reload_all_calls_ready (MMIfaceModemVoice *self,
+                        GAsyncResult      *res)
+{
+    g_autoptr(GError) error = NULL;
+
+    if (!mm_iface_modem_voice_reload_all_calls_finish (self, res, &error))
+        mm_obj_dbg (self, "couldn't reload call list after +ECPI: %s", error->message);
+}
+
+static gboolean
+call_list_reload_cb (MMBroadbandModemMtkCcci *self)
+{
+    self->priv->call_list_reload_id = 0;
+    mm_iface_modem_voice_reload_all_calls (MM_IFACE_MODEM_VOICE (self),
+                                           (GAsyncReadyCallback) reload_all_calls_ready,
+                                           NULL);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+schedule_call_list_reload (MMBroadbandModemMtkCcci *self)
+{
+    /* Bursts of +ECPI (e.g. 133 + 129 on release) need one +CLCC only */
+    if (!self->priv->call_list_reload_id)
+        self->priv->call_list_reload_id = g_timeout_add (200, (GSourceFunc) call_list_reload_cb, self);
+}
+
+static void
+ecpi_received (MMPortSerialAt          *port,
+               GMatchInfo              *match_info,
+               MMBroadbandModemMtkCcci *self)
+{
+    g_autofree gchar   *str = NULL;
+    g_autoptr(GError)   error = NULL;
+    MMMtkCcciEcpiInfo   info = { 0 };
+    MMCallInfo          call_info = { 0 };
+
+    str = g_match_info_fetch (match_info, 1);
+    if (!mm_mtk_ccci_parse_ecpi (str, &info, &error)) {
+        mm_obj_warn (self, "couldn't parse +ECPI report: %s", error->message);
+        return;
+    }
+
+    mm_obj_dbg (self, "call %u progress: +ECPI message %u%s%s",
+                info.call_id, info.msg_type,
+                info.number ? ", number " : "",
+                info.number ? info.number : "");
+
+    call_info.state = mm_mtk_ccci_ecpi_msg_type_to_call_state (info.msg_type, &call_info.direction);
+    if (call_info.state == MM_CALL_STATE_UNKNOWN) {
+        /* 4 (sync) carries nothing for us; the rest is resolved by +CLCC */
+        if (info.msg_type != 4)
+            schedule_call_list_reload (self);
+        mm_mtk_ccci_ecpi_info_clear (&info);
+        return;
+    }
+
+    if (call_info.direction == MM_CALL_DIRECTION_UNKNOWN && info.has_dir)
+        call_info.direction = info.dir ? MM_CALL_DIRECTION_INCOMING : MM_CALL_DIRECTION_OUTGOING;
+    call_info.index  = info.call_id;
+    call_info.number = info.number;
+    mm_iface_modem_voice_report_call (MM_IFACE_MODEM_VOICE (self), &call_info);
+
+    mm_mtk_ccci_ecpi_info_clear (&info);
+}
+
+static void
+set_ecpi_handler (MMBroadbandModemMtkCcci *self,
+                  gboolean                 enable)
+{
+    MMPortSerialAt *primary;
+
+    primary = mm_base_modem_peek_port_primary (MM_BASE_MODEM (self));
+    if (!primary)
+        return;
+
+    mm_port_serial_at_add_unsolicited_msg_handler (primary,
+                                                   self->priv->ecpi_regex,
+                                                   enable ? (MMPortSerialAtUnsolicitedMsgFn) ecpi_received : NULL,
+                                                   enable ? self : NULL,
+                                                   NULL);
+    if (!enable && self->priv->call_list_reload_id) {
+        g_source_remove (self->priv->call_list_reload_id);
+        self->priv->call_list_reload_id = 0;
+    }
+}
+
+/* Setup unsolicited events (Voice interface) */
+
+static gboolean
+modem_voice_setup_unsolicited_events_finish (MMIfaceModemVoice  *self,
+                                             GAsyncResult       *res,
+                                             GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+parent_voice_setup_unsolicited_events_ready (MMIfaceModemVoice *self,
+                                             GAsyncResult      *res,
+                                             GTask             *task)
+{
+    GError *error = NULL;
+
+    if (!iface_modem_voice_parent->setup_unsolicited_events_finish (self, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    set_ecpi_handler (MM_BROADBAND_MODEM_MTK_CCCI (self), TRUE);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+modem_voice_setup_unsolicited_events (MMIfaceModemVoice   *self,
+                                      GAsyncReadyCallback  callback,
+                                      gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    iface_modem_voice_parent->setup_unsolicited_events (
+        self,
+        (GAsyncReadyCallback) parent_voice_setup_unsolicited_events_ready,
+        task);
+}
+
+/* Cleanup unsolicited events (Voice interface) */
+
+static gboolean
+modem_voice_cleanup_unsolicited_events_finish (MMIfaceModemVoice  *self,
+                                               GAsyncResult       *res,
+                                               GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+parent_voice_cleanup_unsolicited_events_ready (MMIfaceModemVoice *self,
+                                               GAsyncResult      *res,
+                                               GTask             *task)
+{
+    GError *error = NULL;
+
+    if (!iface_modem_voice_parent->cleanup_unsolicited_events_finish (self, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+modem_voice_cleanup_unsolicited_events (MMIfaceModemVoice   *self,
+                                        GAsyncReadyCallback  callback,
+                                        gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    /* Keep swallowing +ECPI, just stop handling it */
+    set_ecpi_handler (MM_BROADBAND_MODEM_MTK_CCCI (self), FALSE);
+    iface_modem_voice_parent->cleanup_unsolicited_events (
+        self,
+        (GAsyncReadyCallback) parent_voice_cleanup_unsolicited_events_ready,
+        task);
+}
+
+/* Enable unsolicited events (Voice interface)
+ *
+ * The stock RIL enables every +ECPI message type with AT+ECPI=4294967295
+ * (bitmask, all bits). Not fatal: the MD already reports the common ones. */
+
+static gboolean
+modem_voice_enable_unsolicited_events_finish (MMIfaceModemVoice  *self,
+                                              GAsyncResult       *res,
+                                              GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+ecpi_enable_ready (MMBaseModem  *self,
+                   GAsyncResult *res,
+                   GTask        *task)
+{
+    g_autoptr(GError) error = NULL;
+
+    if (!mm_base_modem_at_command_finish (self, res, &error))
+        mm_obj_dbg (self, "couldn't enable all +ECPI reports (ignored): %s", error->message);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+parent_voice_enable_unsolicited_events_ready (MMIfaceModemVoice *self,
+                                              GAsyncResult      *res,
+                                              GTask             *task)
+{
+    GError *error = NULL;
+
+    if (!iface_modem_voice_parent->enable_unsolicited_events_finish (self, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+ECPI=4294967295", 5, FALSE,
+                              (GAsyncReadyCallback) ecpi_enable_ready, task);
+}
+
+static void
+modem_voice_enable_unsolicited_events (MMIfaceModemVoice   *self,
+                                       GAsyncReadyCallback  callback,
+                                       gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    iface_modem_voice_parent->enable_unsolicited_events (
+        self,
+        (GAsyncReadyCallback) parent_voice_enable_unsolicited_events_ready,
+        task);
+}
+
+/* Hangup all (Voice interface): the stock RIL uses ATH, not +CHUP */
+
+static gboolean
+modem_voice_hangup_all_finish (MMIfaceModemVoice  *self,
+                               GAsyncResult       *res,
+                               GError            **error)
+{
+    return !!mm_base_modem_at_command_finish (MM_BASE_MODEM (self), res, error);
+}
+
+static void
+modem_voice_hangup_all (MMIfaceModemVoice   *self,
+                        GAsyncReadyCallback  callback,
+                        gpointer             user_data)
+{
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "H", 5, FALSE, callback, user_data);
+}
+
+/*****************************************************************************/
+
+MMBroadbandModemMtkCcci *
+mm_broadband_modem_mtk_ccci_new (const gchar  *device,
+                                 const gchar  *physdev,
+                                 const gchar **drivers,
+                                 const gchar  *plugin,
+                                 guint16       vendor_id,
+                                 guint16       product_id)
+{
+    return g_object_new (MM_TYPE_BROADBAND_MODEM_MTK_CCCI,
+                         MM_BASE_MODEM_DEVICE,     device,
+                         MM_BASE_MODEM_PHYSDEV,    physdev,
+                         MM_BASE_MODEM_DRIVERS,    drivers,
+                         MM_BASE_MODEM_PLUGIN,     plugin,
+                         MM_BASE_MODEM_VENDOR_ID,  vendor_id,
+                         MM_BASE_MODEM_PRODUCT_ID, product_id,
+                         /* Data only over the ccmni net ports, never PPP */
+                         MM_BASE_MODEM_DATA_NET_SUPPORTED, TRUE,
+                         MM_BASE_MODEM_DATA_TTY_SUPPORTED, FALSE,
+                         NULL);
+}
+
+static void
+mm_broadband_modem_mtk_ccci_init (MMBroadbandModemMtkCcci *self)
+{
+    guint i;
+
+    self->priv = mm_broadband_modem_mtk_ccci_get_instance_private (self);
+
+    self->priv->eif_regex  = mtk_ccci_regex_new (MTK_CCCI_URC_REGEX ("EIF"));
+    self->priv->ecpi_regex = mtk_ccci_regex_new (MTK_CCCI_URC_REGEX ("ECPI"));
+    self->priv->ignored_regexes = g_ptr_array_new_with_free_func ((GDestroyNotify) g_regex_unref);
+    for (i = 0; i < G_N_ELEMENTS (mtk_ccci_ignored_urcs); i++)
+        g_ptr_array_add (self->priv->ignored_regexes, mtk_ccci_regex_new (mtk_ccci_ignored_urcs[i]));
+    self->priv->active_pdns = g_hash_table_new_full (g_direct_hash, g_direct_equal, NULL,
+                                                     (GDestroyNotify) mm_mtk_ccci_eif_info_free);
+}
+
+static void
+dispose (GObject *object)
+{
+    MMBroadbandModemMtkCcci *self = MM_BROADBAND_MODEM_MTK_CCCI (object);
+
+    if (self->priv->call_list_reload_id) {
+        g_source_remove (self->priv->call_list_reload_id);
+        self->priv->call_list_reload_id = 0;
+    }
+
+    G_OBJECT_CLASS (mm_broadband_modem_mtk_ccci_parent_class)->dispose (object);
+}
+
+static void
+finalize (GObject *object)
+{
+    MMBroadbandModemMtkCcci *self = MM_BROADBAND_MODEM_MTK_CCCI (object);
+
+    g_regex_unref (self->priv->eif_regex);
+    g_regex_unref (self->priv->ecpi_regex);
+    g_ptr_array_unref (self->priv->ignored_regexes);
+    g_hash_table_unref (self->priv->active_pdns);
+
+    G_OBJECT_CLASS (mm_broadband_modem_mtk_ccci_parent_class)->finalize (object);
+}
+
+static void
+iface_modem_init (MMIfaceModemInterface *iface)
+{
+    iface_modem_parent = g_type_interface_peek_parent (iface);
+
+    iface->modem_power_up        = modem_power_up;
+    iface->modem_power_up_finish = modem_power_up_finish;
+    iface->create_bearer         = modem_create_bearer;
+    iface->create_bearer_finish  = modem_create_bearer_finish;
+}
+
+static void
+iface_modem_voice_init (MMIfaceModemVoiceInterface *iface)
+{
+    iface_modem_voice_parent = g_type_interface_peek_parent (iface);
+
+    iface->setup_unsolicited_events          = modem_voice_setup_unsolicited_events;
+    iface->setup_unsolicited_events_finish   = modem_voice_setup_unsolicited_events_finish;
+    iface->cleanup_unsolicited_events        = modem_voice_cleanup_unsolicited_events;
+    iface->cleanup_unsolicited_events_finish = modem_voice_cleanup_unsolicited_events_finish;
+    iface->enable_unsolicited_events         = modem_voice_enable_unsolicited_events;
+    iface->enable_unsolicited_events_finish  = modem_voice_enable_unsolicited_events_finish;
+    iface->hangup_all                        = modem_voice_hangup_all;
+    iface->hangup_all_finish                 = modem_voice_hangup_all_finish;
+}
+
+static void
+mm_broadband_modem_mtk_ccci_class_init (MMBroadbandModemMtkCcciClass *klass)
+{
+    GObjectClass          *object_class    = G_OBJECT_CLASS (klass);
+    MMBroadbandModemClass *broadband_class = MM_BROADBAND_MODEM_CLASS (klass);
+
+    object_class->dispose  = dispose;
+    object_class->finalize = finalize;
+
+    broadband_class->setup_ports                   = setup_ports;
+    broadband_class->initialization_started        = initialization_started;
+    broadband_class->initialization_started_finish = initialization_started_finish;
+
+    signals[SIGNAL_EIF] =
+        g_signal_new (MM_BROADBAND_MODEM_MTK_CCCI_SIGNAL_EIF,
+                      G_OBJECT_CLASS_TYPE (object_class),
+                      G_SIGNAL_RUN_LAST,
+                      0, NULL, NULL,
+                      g_cclosure_marshal_VOID__POINTER,
+                      G_TYPE_NONE, 1, G_TYPE_POINTER);
+}
