+/*****************************************************************************/
+/* +ECPI */
+
+static void
+test_ecpi_parse (void)
+{
+    MMMtkCcciEcpiInfo info = { 0 };
+    g_autoptr(GError) error = NULL;
+
+    g_assert (mm_mtk_ccci_parse_ecpi ("+ECPI: 1,130,0,0,0,0,\"+5511999998888\",145,\"\"", &info, &error));
+    g_assert_no_error (error);
+    g_assert_cmpuint (info.call_id, ==, 1);
+    g_assert_cmpuint (info.msg_type, ==, 130);
+    g_assert (info.has_dir);
+    g_assert_cmpuint (info.dir, ==, 0);
+    g_assert_cmpstr (info.number, ==, "+5511999998888");
+    g_assert (!info.has_cause);
+    mm_mtk_ccci_ecpi_info_clear (&info);
+
+    /* Release: "+ECPI:<call_id>,<msg_type>,<is_ibt>,<is_tch>,,,"",,"",<cause>" */
+    g_assert (mm_mtk_ccci_parse_ecpi ("+ECPI: 1,133,0,0,,,\"\",,\"\",16", &info, &error));
+    g_assert_no_error (error);
+    g_assert_cmpuint (info.msg_type, ==, 133);
+    g_assert (!info.has_dir);
+    g_assert_null (info.number);
+    g_assert (info.has_cause);
+    g_assert_cmpuint (info.cause, ==, 16);
+    mm_mtk_ccci_ecpi_info_clear (&info);
+
+    /* Incoming call setup */
+    g_assert (mm_mtk_ccci_parse_ecpi ("+ECPI: 2,0,0,0,1,0,\"11988887777\",129,\"\"", &info, &error));
+    g_assert_no_error (error);
+    g_assert_cmpuint (info.call_id, ==, 2);
+    g_assert (info.has_dir);
+    g_assert_cmpuint (info.dir, ==, 1);
+    mm_mtk_ccci_ecpi_info_clear (&info);
+
+    /* State change report with only the first two fields */
+    g_assert (mm_mtk_ccci_parse_ecpi ("+ECPI: 1,129", &info, &error));
+    g_assert_no_error (error);
+    g_assert_cmpuint (info.msg_type, ==, 129);
+    mm_mtk_ccci_ecpi_info_clear (&info);
+}
+
+static void
+test_ecpi_invalid (void)
+{
+    MMMtkCcciEcpiInfo info = { 0 };
+    GError           *error = NULL;
+
+    g_assert (!mm_mtk_ccci_parse_ecpi ("+ECPI: x,130", &info, &error));
+    g_assert_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS);
+    g_clear_error (&error);
+
+    g_assert (!mm_mtk_ccci_parse_ecpi ("+ECPI: 1", &info, &error));
+    g_clear_error (&error);
+}
+
+static void
+test_ecpi_call_state (void)
+{
+    static const struct {
+        guint           msg_type;
+        MMCallState     state;
+        MMCallDirection direction;
+    } map[] = {
+        { 130, MM_CALL_STATE_DIALING,     MM_CALL_DIRECTION_OUTGOING },
+        { 2,   MM_CALL_STATE_RINGING_OUT, MM_CALL_DIRECTION_OUTGOING },
+        { 6,   MM_CALL_STATE_ACTIVE,      MM_CALL_DIRECTION_UNKNOWN  },
+        { 132, MM_CALL_STATE_ACTIVE,      MM_CALL_DIRECTION_UNKNOWN  },
+        { 131, MM_CALL_STATE_HELD,        MM_CALL_DIRECTION_UNKNOWN  },
+        { 133, MM_CALL_STATE_TERMINATED,  MM_CALL_DIRECTION_UNKNOWN  },
+        /* resolved by +CLCC */
+        { 0,   MM_CALL_STATE_UNKNOWN,     MM_CALL_DIRECTION_UNKNOWN  },
+        { 1,   MM_CALL_STATE_UNKNOWN,     MM_CALL_DIRECTION_UNKNOWN  },
+        { 3,   MM_CALL_STATE_UNKNOWN,     MM_CALL_DIRECTION_UNKNOWN  },
+        { 4,   MM_CALL_STATE_UNKNOWN,     MM_CALL_DIRECTION_UNKNOWN  },
+        { 5,   MM_CALL_STATE_UNKNOWN,     MM_CALL_DIRECTION_UNKNOWN  },
+        { 129, MM_CALL_STATE_UNKNOWN,     MM_CALL_DIRECTION_UNKNOWN  },
+        { 134, MM_CALL_STATE_UNKNOWN,     MM_CALL_DIRECTION_UNKNOWN  },
+        { 999, MM_CALL_STATE_UNKNOWN,     MM_CALL_DIRECTION_UNKNOWN  },
+    };
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS (map); i++) {
+        MMCallDirection direction = MM_CALL_DIRECTION_INCOMING;
+
+        g_assert_cmpint (mm_mtk_ccci_ecpi_msg_type_to_call_state (map[i].msg_type, &direction), ==, map[i].state);
+        g_assert_cmpint (direction, ==, map[i].direction);
+    }
+}
