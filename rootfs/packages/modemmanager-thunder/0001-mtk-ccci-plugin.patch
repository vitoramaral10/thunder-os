+/*****************************************************************************/
+/* +EIF */
+
+static void
+test_eif_ifup (void)
+{
+    MMMtkCcciEifInfo  info = { 0 };
+    g_autoptr(GError) error = NULL;
+    g_autofree gchar *name = NULL;
+
+    /* As measured on the Redmi 10 5G */
+    g_assert (mm_mtk_ccci_parse_eif ("+EIF: 100, ifup, 1, 10.144.22.7, 0", &info, &error));
+    g_assert_no_error (error);
+    g_assert_cmpuint (info.trans_intf_id, ==, 100);
+    g_assert_cmpuint (info.interface_index, ==, 0);
+    g_assert_cmpint (info.event, ==, MM_MTK_CCCI_EIF_EVENT_IFUP);
+    g_assert (info.has_cid);
+    g_assert_cmpuint (info.cid, ==, 1);
+    g_assert_cmpstr (info.ipv4, ==, "10.144.22.7");
+    g_assert_null (info.ipv6);
+    name = mm_mtk_ccci_build_net_port_name (info.trans_intf_id);
+    g_assert_cmpstr (name, ==, "ccmni0");
+    mm_mtk_ccci_eif_info_clear (&info);
+
+    /* Second transaction lands on ccmni1; payload without the tag */
+    g_assert (mm_mtk_ccci_parse_eif ("201,ifup,2,\"100.64.1.2\",0", &info, &error));
+    g_assert_no_error (error);
+    g_assert_cmpuint (info.interface_index, ==, 1);
+    g_assert_cmpuint (info.cid, ==, 2);
+    g_assert_cmpstr (info.ipv4, ==, "100.64.1.2");
+    g_clear_pointer (&name, g_free);
+    name = mm_mtk_ccci_build_net_port_name (info.trans_intf_id);
+    g_assert_cmpstr (name, ==, "ccmni1");
+    mm_mtk_ccci_eif_info_clear (&info);
+
+    /* IPv6 interface identifier in the 5th field */
+    g_assert (mm_mtk_ccci_parse_eif ("+EIF: 102, ifup, 3, 0.0.0.0, FE80::1:2", &info, &error));
+    g_assert_no_error (error);
+    g_assert_cmpuint (info.interface_index, ==, 2);
+    g_assert_null (info.ipv4);
+    g_assert_cmpstr (info.ipv6, ==, "fe80::1:2");
+    mm_mtk_ccci_eif_info_clear (&info);
+}
+
+static void
+test_eif_ifdown_ifchg (void)
+{
+    MMMtkCcciEifInfo  up = { 0 };
+    MMMtkCcciEifInfo  report = { 0 };
+    g_autoptr(GError) error = NULL;
+
+    g_assert (mm_mtk_ccci_parse_eif ("+EIF: 100, ifup, 1, 10.144.22.7, 0", &up, &error));
+    g_assert_no_error (error);
+
+    g_assert (mm_mtk_ccci_parse_eif ("+EIF: 100, ifdown", &report, &error));
+    g_assert_no_error (error);
+    g_assert_cmpint (report.event, ==, MM_MTK_CCCI_EIF_EVENT_IFDOWN);
+    g_assert (!report.has_cid);
+    g_assert (mm_mtk_ccci_eif_same_interface (&up, &report));
+    mm_mtk_ccci_eif_info_clear (&report);
+
+    /* A stale ifdown of an older transaction on the same ccmni must not
+     * tear down the new one */
+    g_assert (mm_mtk_ccci_parse_eif ("+EIF: 200, ifdown", &report, &error));
+    g_assert (!mm_mtk_ccci_eif_same_interface (&up, &report));
+    mm_mtk_ccci_eif_info_clear (&report);
+
+    /* A report with only the interface index matches by index */
+    g_assert (mm_mtk_ccci_parse_eif ("+EIF: 0, ifdown", &report, &error));
+    g_assert (mm_mtk_ccci_eif_same_interface (&up, &report));
+    mm_mtk_ccci_eif_info_clear (&report);
+
+    /* CS fallback during a call */
+    g_assert (mm_mtk_ccci_parse_eif ("+EIF: 100, ifchg, 1", &report, &error));
+    g_assert_cmpint (report.event, ==, MM_MTK_CCCI_EIF_EVENT_IFCHG);
+    g_assert (mm_mtk_ccci_eif_same_interface (&up, &report));
+    mm_mtk_ccci_eif_info_clear (&report);
+
+    g_assert (mm_mtk_ccci_parse_eif ("+EIF: 100, IFCHANGE", &report, &error));
+    g_assert_cmpint (report.event, ==, MM_MTK_CCCI_EIF_EVENT_IFCHG);
+    mm_mtk_ccci_eif_info_clear (&report);
+
+    /* Unknown events are reported, not rejected */
+    g_assert (mm_mtk_ccci_parse_eif ("+EIF: 100, ra", &report, &error));
+    g_assert_cmpint (report.event, ==, MM_MTK_CCCI_EIF_EVENT_UNKNOWN);
+    g_assert_cmpstr (report.event_str, ==, "ra");
+    mm_mtk_ccci_eif_info_clear (&report);
+
+    mm_mtk_ccci_eif_info_clear (&up);
+}
+
+static void
+test_eif_invalid (void)
+{
+    MMMtkCcciEifInfo info = { 0 };
+    GError          *error = NULL;
+
+    g_assert (!mm_mtk_ccci_parse_eif ("+EIF: abc, ifup", &info, &error));
+    g_assert_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS);
+    g_clear_error (&error);
+
+    g_assert (!mm_mtk_ccci_parse_eif ("+EIF: 100", &info, &error));
+    g_assert_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS);
+    g_clear_error (&error);
+
+    g_assert (!mm_mtk_ccci_parse_eif ("+EIF: 100,", &info, &error));
+    g_clear_error (&error);
+}
