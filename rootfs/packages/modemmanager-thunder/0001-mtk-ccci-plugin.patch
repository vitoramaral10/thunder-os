diff --git c/src/plugins/mtk-ccci/77-mm-mtk-ccci.rules i/src/plugins/mtk-ccci/77-mm-mtk-ccci.rules
new file mode 100644
index 0000000..f4e2231
--- /dev/null
+++ i/src/plugins/mtk-ccci/77-mm-mtk-ccci.rules
@@ -0,0 +1,24 @@
+# do not edit this file, it will be overwritten on update
+
+# MediaTek SoC modem (MD1) on vendor kernels: the CCCI AT channel (ttyC0, a
+# tty) and the ccmniN network devices carry no USB/PCI ids. Tag them for the
+# mtk-ccci plugin and give them a common physdev UID so that they all make up
+# one modem. ccmni-lan (tethering) does not match and is left alone.
+# Only one MD is handled; a SoC exposing more would need one UID per MD.
+
+ACTION!="add|change|move|bind", GOTO="mm_mtk_ccci_end"
+
+SUBSYSTEM=="tty", KERNEL=="ttyC0", GOTO="mm_mtk_ccci_at"
+SUBSYSTEM=="net", KERNEL=="ccmni[0-9]*", GOTO="mm_mtk_ccci_port"
+GOTO="mm_mtk_ccci_end"
+
+LABEL="mm_mtk_ccci_at"
+ENV{ID_MM_PORT_TYPE_AT_PRIMARY}="1"
+# fall through: the AT port gets the common tags too
+
+LABEL="mm_mtk_ccci_port"
+ENV{ID_MM_CANDIDATE}="1"
+ENV{ID_MM_MTK_CCCI}="1"
+ENV{ID_MM_PHYSDEV_UID}="mtk-ccci-md1"
+
+LABEL="mm_mtk_ccci_end"
diff --git c/src/plugins/mtk-ccci/mm-broadband-bearer-mtk-ccci.c i/src/plugins/mtk-ccci/mm-broadband-bearer-mtk-ccci.c
new file mode 100644
index 0000000..5644463
--- /dev/null
+++ i/src/plugins/mtk-ccci/mm-broadband-bearer-mtk-ccci.c
@@ -0,0 +1,934 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 Thunder OS contributors
+ *
+ * Data bearer of MediaTek SoC modems over CCCI (AT only, no MIPC).
+ *
+ * The generic 3GPP sequence of MMBroadbandBearer (profile selection with
+ * +CGDCONT, then dial, then IP config) is kept; only dialing, IP config and
+ * disconnection are replaced:
+ *
+ *  - dial: if the cid is already active on a known interface it is reused;
+ *    otherwise +CGDCONT is written again for the cid (the MD activates an
+ *    undefined cid on an emergency APN) and +CGACT=1,<cid> sent. The MD then
+ *    reports "+EIF: <id>, ifup, <cid>, <ipv4>, ..." and the data interface is
+ *    ccmni<id % 100>, which must have been grabbed as a net port. Without the
+ *    report within 20 s the context is cycled once.
+ *  - IP config: static, from the +EIF report, +CGCONTRDP and +CGPADDR. The
+ *    ccmni devices are NOARP point-to-point links without DHCP: IPv4 is the
+ *    PDN address as /32 with no gateway.
+ *  - disconnect: +CGACT=0,<cid> (the MD then reports "ifdown").
+ *
+ * An "ifdown" not requested by us reports the bearer as disconnected; an
+ * "ifchg" (e.g. CS fallback during a voice call) keeps it.
+ */
+
+#include <config.h>
+
+#include <string.h>
+
+#include <ModemManager.h>
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-base-modem-at.h"
+#include "mm-broadband-bearer-mtk-ccci.h"
+#include "mm-log-object.h"
+#include "mm-modem-helpers.h"
+#include "mm-modem-helpers-mtk-ccci.h"
+#include "mm-port-net.h"
+
+struct _MMBroadbandBearerMtkCcciPrivate {
+    /* +EIF ifup of the current connection, NULL when not connected */
+    MMMtkCcciEifInfo *connected;
+};
+
+G_DEFINE_TYPE_WITH_PRIVATE (MMBroadbandBearerMtkCcci, mm_broadband_bearer_mtk_ccci, MM_TYPE_BROADBAND_BEARER)
+
+/* Time to wait for the +EIF ifup after +CGACT=1 returned OK */
+#define EIF_IFUP_TIMEOUT_SECS 20
+#define CGACT_TIMEOUT_SECS    60
+
+/*****************************************************************************/
+/* Track the interface of the current connection */
+
+static void
+modem_eif_report (MMBroadbandModemMtkCcci  *modem,
+                  const MMMtkCcciEifInfo   *info,
+                  MMBroadbandBearerMtkCcci *self)
+{
+    if (!self->priv->connected || !mm_mtk_ccci_eif_same_interface (self->priv->connected, info))
+        return;
+
+    switch (info->event) {
+    case MM_MTK_CCCI_EIF_EVENT_IFDOWN:
+        mm_obj_info (self, "ccmni%u went down: connection lost", info->interface_index);
+        g_clear_pointer (&self->priv->connected, mm_mtk_ccci_eif_info_free);
+        mm_base_bearer_report_connection_status (MM_BASE_BEARER (self),
+                                                 MM_BEARER_CONNECTION_STATUS_DISCONNECTED);
+        break;
+    case MM_MTK_CCCI_EIF_EVENT_IFCHG:
+        mm_obj_info (self, "ccmni%u changed: connection kept", info->interface_index);
+        if (info->ipv4 && g_strcmp0 (info->ipv4, self->priv->connected->ipv4) != 0)
+            mm_obj_warn (self, "ccmni%u reports a new IPv4 address %s (was %s); reconnect to apply it",
+                         info->interface_index, info->ipv4,
+                         self->priv->connected->ipv4 ? self->priv->connected->ipv4 : "n/a");
+        break;
+    case MM_MTK_CCCI_EIF_EVENT_IFUP:
+    case MM_MTK_CCCI_EIF_EVENT_UNKNOWN:
+    default:
+        break;
+    }
+}
+
+/*****************************************************************************/
+/* 3GPP dialing (sub-step of the 3GPP connection sequence) */
+
+typedef struct {
+    MMBroadbandModemMtkCcci *modem;
+    MMPortSerialAt          *primary;
+    guint                    cid;
+    gulong                   eif_id;
+    guint                    timeout_id;
+    gboolean                 activated;  /* +CGACT=1 returned OK */
+    gboolean                 retried;
+    MMMtkCcciEifInfo        *ifup;
+} DialContext;
+
+static void
+dial_context_free (DialContext *ctx)
+{
+    if (ctx->eif_id)
+        g_signal_handler_disconnect (ctx->modem, ctx->eif_id);
+    if (ctx->timeout_id)
+        g_source_remove (ctx->timeout_id);
+    mm_mtk_ccci_eif_info_free (ctx->ifup);
+    g_object_unref (ctx->primary);
+    g_object_unref (ctx->modem);
+    g_slice_free (DialContext, ctx);
+}
+
+static MMPort *
+dial_3gpp_finish (MMBroadbandBearer  *self,
+                  GAsyncResult       *res,
+                  GError            **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+dial_stop_waiting (DialContext *ctx)
+{
+    if (ctx->eif_id) {
+        g_signal_handler_disconnect (ctx->modem, ctx->eif_id);
+        ctx->eif_id = 0;
+    }
+    if (ctx->timeout_id) {
+        g_source_remove (ctx->timeout_id);
+        ctx->timeout_id = 0;
+    }
+}
+
+static void
+dial_complete (GTask                  *task,
+               const MMMtkCcciEifInfo *ifup)
+{
+    MMBroadbandBearerMtkCcci *self;
+    DialContext              *ctx;
+    g_autofree gchar         *name = NULL;
+    MMPort                   *port;
+
+    self = g_task_get_source_object (task);
+    ctx  = g_task_get_task_data (task);
+
+    dial_stop_waiting (ctx);
+
+    name = mm_mtk_ccci_build_net_port_name (ifup->trans_intf_id);
+    port = mm_base_modem_get_port (MM_BASE_MODEM (ctx->modem), name);
+    if (!port || mm_port_get_port_type (port) != MM_PORT_TYPE_NET) {
+        g_clear_object (&port);
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_NOT_FOUND,
+                                 "PDP context %u is up on %s, which is not a net port of this modem",
+                                 ctx->cid, name);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_info (self, "PDP context %u connected on %s", ctx->cid, name);
+    g_clear_pointer (&self->priv->connected, mm_mtk_ccci_eif_info_free);
+    self->priv->connected = mm_mtk_ccci_eif_info_dup (ifup);
+
+    g_task_return_pointer (task, port, g_object_unref);
+    g_object_unref (task);
+}
+
+static void dial_activate            (GTask *task);
+static void dial_define_and_activate (GTask *task);
+
+static void
+dial_eif_report (MMBroadbandModemMtkCcci *modem,
+                 const MMMtkCcciEifInfo  *info,
+                 GTask                   *task)
+{
+    DialContext *ctx;
+
+    ctx = g_task_get_task_data (task);
+    if (info->event != MM_MTK_CCCI_EIF_EVENT_IFUP || !info->has_cid || info->cid != ctx->cid)
+        return;
+
+    mm_mtk_ccci_eif_info_free (ctx->ifup);
+    ctx->ifup = mm_mtk_ccci_eif_info_dup (info);
+
+    /* The report may come before the final OK of +CGACT */
+    if (ctx->activated)
+        dial_complete (task, ctx->ifup);
+}
+
+static void
+retry_cgact_deactivate_ready (MMBaseModem  *modem,
+                              GAsyncResult *res,
+                              GTask        *task)
+{
+    g_autoptr(GError) error = NULL;
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error))
+        mm_obj_dbg (g_task_get_source_object (task), "PDP context deactivation before retry failed: %s",
+                    error->message);
+    if (g_task_return_error_if_cancelled (task)) {
+        g_object_unref (task);
+        return;
+    }
+    dial_define_and_activate (task);
+}
+
+static void
+dial_deactivate_and_activate (GTask *task)
+{
+    DialContext      *ctx;
+    g_autofree gchar *cmd = NULL;
+
+    ctx = g_task_get_task_data (task);
+    ctx->retried = TRUE;
+    cmd = g_strdup_printf ("+CGACT=0,%u", ctx->cid);
+    mm_base_modem_at_command_full (MM_BASE_MODEM (ctx->modem),
+                                   MM_IFACE_PORT_AT (ctx->primary),
+                                   cmd,
+                                   CGACT_TIMEOUT_SECS,
+                                   FALSE, FALSE, NULL,
+                                   (GAsyncReadyCallback) retry_cgact_deactivate_ready,
+                                   task);
+}
+
+static gboolean
+dial_ifup_timeout (GTask *task)
+{
+    DialContext *ctx;
+
+    ctx = g_task_get_task_data (task);
+    ctx->timeout_id = 0;
+
+    /* The task may outlive its return until the callback runs: never leave
+     * the +EIF handler connected to a returned task */
+    if (g_task_return_error_if_cancelled (task)) {
+        dial_stop_waiting (ctx);
+        g_object_unref (task);
+        return G_SOURCE_REMOVE;
+    }
+
+    if (!ctx->retried) {
+        mm_obj_info (g_task_get_source_object (task),
+                     "no +EIF ifup for PDP context %u after %us: deactivating and trying again",
+                     ctx->cid, EIF_IFUP_TIMEOUT_SECS);
+        dial_stop_waiting (ctx);
+        dial_deactivate_and_activate (task);
+        return G_SOURCE_REMOVE;
+    }
+
+    dial_stop_waiting (ctx);
+    g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_TIMEOUT,
+                             "PDP context %u activated but the modem never reported its interface (+EIF ifup)",
+                             ctx->cid);
+    g_object_unref (task);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+cgact_activate_ready (MMBaseModem  *modem,
+                      GAsyncResult *res,
+                      GTask        *task)
+{
+    DialContext *ctx;
+    GError      *error = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        dial_stop_waiting (ctx);
+        g_prefix_error (&error, "Couldn't activate PDP context %u: ", ctx->cid);
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    if (g_task_return_error_if_cancelled (task)) {
+        dial_stop_waiting (ctx);
+        g_object_unref (task);
+        return;
+    }
+
+    ctx->activated = TRUE;
+    if (ctx->ifup) {
+        dial_complete (task, ctx->ifup);
+        return;
+    }
+
+    ctx->timeout_id = g_timeout_add_seconds (EIF_IFUP_TIMEOUT_SECS, (GSourceFunc) dial_ifup_timeout, task);
+}
+
+static void
+dial_activate (GTask *task)
+{
+    DialContext      *ctx;
+    g_autofree gchar *cmd = NULL;
+
+    ctx = g_task_get_task_data (task);
+    ctx->activated = FALSE;
+    g_clear_pointer (&ctx->ifup, mm_mtk_ccci_eif_info_free);
+
+    /* Listen before sending: the ifup may arrive before the final OK */
+    g_assert (!ctx->eif_id);
+    ctx->eif_id = g_signal_connect (ctx->modem,
+                                    MM_BROADBAND_MODEM_MTK_CCCI_SIGNAL_EIF,
+                                    G_CALLBACK (dial_eif_report),
+                                    task);
+
+    cmd = g_strdup_printf ("+CGACT=1,%u", ctx->cid);
+    mm_base_modem_at_command_full (MM_BASE_MODEM (ctx->modem),
+                                   MM_IFACE_PORT_AT (ctx->primary),
+                                   cmd,
+                                   CGACT_TIMEOUT_SECS,
+                                   FALSE, FALSE,
+                                   g_task_get_cancellable (task),
+                                   (GAsyncReadyCallback) cgact_activate_ready,
+                                   task);
+}
+
+static void
+cgact_query_ready (MMBaseModem  *modem,
+                   GAsyncResult *res,
+                   GTask        *task)
+{
+    DialContext       *ctx;
+    const gchar       *response;
+    g_autoptr(GError)  error = NULL;
+    GList             *list = NULL;
+    GList             *l;
+    gboolean           active = FALSE;
+
+    ctx = g_task_get_task_data (task);
+
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (response)
+        list = mm_3gpp_parse_cgact_read_response (response, &error);
+    if (error)
+        mm_obj_dbg (g_task_get_source_object (task), "couldn't query active PDP contexts: %s", error->message);
+
+    if (g_task_return_error_if_cancelled (task)) {
+        mm_3gpp_pdp_context_active_list_free (list);
+        g_object_unref (task);
+        return;
+    }
+
+    for (l = list; l; l = g_list_next (l)) {
+        MM3gppPdpContextActive *pdp = l->data;
+
+        if (pdp->cid == ctx->cid) {
+            active = pdp->active;
+            break;
+        }
+    }
+    mm_3gpp_pdp_context_active_list_free (list);
+
+    if (!active) {
+        dial_define_and_activate (task);
+        return;
+    }
+
+    /* Already active (e.g. ModemManager restarted, or a previous disconnect
+     * failed): reuse it if its interface is known, otherwise cycle it to get
+     * a fresh +EIF ifup. */
+    {
+        const MMMtkCcciEifInfo *known;
+
+        known = mm_broadband_modem_mtk_ccci_peek_active_pdn (ctx->modem, ctx->cid);
+        if (known) {
+            mm_obj_dbg (g_task_get_source_object (task), "PDP context %u already active on ccmni%u",
+                        ctx->cid, known->interface_index);
+            dial_complete (task, known);
+            return;
+        }
+    }
+
+    mm_obj_dbg (g_task_get_source_object (task), "PDP context %u already active on an unknown interface", ctx->cid);
+    dial_deactivate_and_activate (task);
+}
+
+static void
+dial_check_active (GTask *task)
+{
+    DialContext *ctx;
+
+    ctx = g_task_get_task_data (task);
+    mm_base_modem_at_command_full (MM_BASE_MODEM (ctx->modem),
+                                   MM_IFACE_PORT_AT (ctx->primary),
+                                   "+CGACT?",
+                                   10,
+                                   FALSE, FALSE,
+                                   g_task_get_cancellable (task),
+                                   (GAsyncReadyCallback) cgact_query_ready,
+                                   task);
+}
+
+static void
+cgdcont_ready (MMBaseModem  *modem,
+               GAsyncResult *res,
+               GTask        *task)
+{
+    DialContext       *ctx;
+    g_autoptr(GError)  error = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    /* Not fatal: the profile manager already defined the context */
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error))
+        mm_obj_warn (g_task_get_source_object (task), "couldn't define PDP context %u again: %s",
+                     ctx->cid, error->message);
+
+    if (g_task_return_error_if_cancelled (task)) {
+        g_object_unref (task);
+        return;
+    }
+
+    dial_activate (task);
+}
+
+/* The profile manager already selected (and usually defined) the cid; define
+ * it again right before activating it, as measured on the MD: activating a
+ * cid it does not consider defined brings up an emergency APN (IMS.SOS.SP)
+ * instead. Skipped when connecting by profile id only (no APN). The context
+ * is never active here: redefining an active context may be refused. */
+static void
+dial_define_and_activate (GTask *task)
+{
+    DialContext        *ctx;
+    MMBearerProperties *config;
+    const gchar        *apn;
+    MMBearerIpFamily    family;
+    g_autofree gchar   *quoted_apn = NULL;
+    g_autofree gchar   *cmd = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    config = mm_base_bearer_peek_config (MM_BASE_BEARER (g_task_get_source_object (task)));
+    apn = mm_bearer_properties_get_apn (config);
+    if (!apn) {
+        dial_activate (task);
+        return;
+    }
+
+    family = mm_bearer_properties_get_ip_type (config);
+    mm_3gpp_normalize_ip_family (&family, TRUE);
+    quoted_apn = mm_at_quote_string (apn);
+    cmd = g_strdup_printf ("+CGDCONT=%u,\"%s\",%s",
+                           ctx->cid, mm_3gpp_get_pdp_type_from_ip_family (family), quoted_apn);
+    mm_base_modem_at_command_full (MM_BASE_MODEM (ctx->modem),
+                                   MM_IFACE_PORT_AT (ctx->primary),
+                                   cmd,
+                                   10,
+                                   FALSE, FALSE,
+                                   g_task_get_cancellable (task),
+                                   (GAsyncReadyCallback) cgdcont_ready,
+                                   task);
+}
+
+static void
+dial_3gpp (MMBroadbandBearer   *_self,
+           MMBaseModem         *modem,
+           MMPortSerialAt      *primary,
+           guint                cid,
+           GCancellable        *cancellable,
+           GAsyncReadyCallback  callback,
+           gpointer             user_data)
+{
+    DialContext *ctx;
+    GTask       *task;
+
+    task = g_task_new (_self, cancellable, callback, user_data);
+
+    ctx = g_slice_new0 (DialContext);
+    ctx->modem   = MM_BROADBAND_MODEM_MTK_CCCI (g_object_ref (modem));
+    ctx->primary = g_object_ref (primary);
+    ctx->cid     = cid;
+    g_task_set_task_data (task, ctx, (GDestroyNotify) dial_context_free);
+
+    dial_check_active (task);
+}
+
+/*****************************************************************************/
+/* 3GPP IP config (sub-step of the 3GPP connection sequence) */
+
+typedef struct {
+    MMBroadbandModemMtkCcci *modem;
+    MMPortSerialAt          *primary;
+    guint                    cid;
+    MMBearerIpFamily         ip_family;
+    MMMtkCcciEifInfo        *ifup;
+    GList                   *pdp_list;
+    gchar                   *cgpaddr_ipv4;
+    gchar                   *cgpaddr_ipv6;
+} IpConfigContext;
+
+typedef struct {
+    MMBearerIpConfig *ipv4;
+    MMBearerIpConfig *ipv6;
+} IpConfigResult;
+
+static void
+ip_config_context_free (IpConfigContext *ctx)
+{
+    mm_mtk_ccci_eif_info_free (ctx->ifup);
+    mm_mtk_ccci_pdp_info_list_free (ctx->pdp_list);
+    g_free (ctx->cgpaddr_ipv4);
+    g_free (ctx->cgpaddr_ipv6);
+    g_object_unref (ctx->primary);
+    g_object_unref (ctx->modem);
+    g_slice_free (IpConfigContext, ctx);
+}
+
+static void
+ip_config_result_free (IpConfigResult *result)
+{
+    g_clear_object (&result->ipv4);
+    g_clear_object (&result->ipv6);
+    g_slice_free (IpConfigResult, result);
+}
+
+static gboolean
+get_ip_config_3gpp_finish (MMBroadbandBearer  *self,
+                           GAsyncResult       *res,
+                           MMBearerIpConfig  **ipv4_config,
+                           MMBearerIpConfig  **ipv6_config,
+                           GError            **error)
+{
+    IpConfigResult *result;
+
+    result = g_task_propagate_pointer (G_TASK (res), error);
+    if (!result)
+        return FALSE;
+
+    if (ipv4_config)
+        *ipv4_config = g_steal_pointer (&result->ipv4);
+    if (ipv6_config)
+        *ipv6_config = g_steal_pointer (&result->ipv6);
+    ip_config_result_free (result);
+    return TRUE;
+}
+
+static const MMMtkCcciPdpInfo *
+find_pdp_info (GList         *list,
+               GSocketFamily  family)
+{
+    GList *l;
+
+    for (l = list; l; l = g_list_next (l)) {
+        const MMMtkCcciPdpInfo *info = l->data;
+
+        if (info->family == family)
+            return info;
+    }
+    return NULL;
+}
+
+/* DNS servers of the given family, from every +CGCONTRDP line */
+static GPtrArray *
+collect_dns (GList         *list,
+             GSocketFamily  family)
+{
+    GPtrArray *dns;
+    GList     *l;
+
+    dns = g_ptr_array_new_with_free_func (g_free);
+    for (l = list; l; l = g_list_next (l)) {
+        const MMMtkCcciPdpInfo *info = l->data;
+        guint                   i;
+
+        for (i = 0; info->dns[i]; i++) {
+            GSocketFamily dns_family;
+            guint         j;
+            gboolean      dup = FALSE;
+
+            if (!mm_mtk_ccci_parse_ip_address (info->dns[i], &dns_family, NULL, NULL) || dns_family != family)
+                continue;
+            for (j = 0; j < dns->len && !dup; j++)
+                dup = g_str_equal (g_ptr_array_index (dns, j), info->dns[i]);
+            if (!dup)
+                g_ptr_array_add (dns, g_strdup (info->dns[i]));
+        }
+    }
+    g_ptr_array_add (dns, NULL);
+    return dns;
+}
+
+static void
+ip_config_complete (GTask *task)
+{
+    MMBroadbandBearerMtkCcci *self;
+    IpConfigContext          *ctx;
+    IpConfigResult           *result;
+    const MMMtkCcciPdpInfo   *pdp4;
+    const MMMtkCcciPdpInfo   *pdp6;
+    const gchar              *ipv4 = NULL;
+    const gchar              *ipv6 = NULL;
+    g_autoptr(GPtrArray)      dns4 = NULL;
+    g_autoptr(GPtrArray)      dns6 = NULL;
+
+    self = g_task_get_source_object (task);
+    ctx  = g_task_get_task_data (task);
+
+    pdp4 = find_pdp_info (ctx->pdp_list, G_SOCKET_FAMILY_IPV4);
+    pdp6 = find_pdp_info (ctx->pdp_list, G_SOCKET_FAMILY_IPV6);
+    dns4 = collect_dns (ctx->pdp_list, G_SOCKET_FAMILY_IPV4);
+    dns6 = collect_dns (ctx->pdp_list, G_SOCKET_FAMILY_IPV6);
+
+    /* Address preference: the +EIF report (what the MD configured on the
+     * interface), then +CGCONTRDP, then +CGPADDR */
+    if (ctx->ifup && ctx->ifup->ipv4)
+        ipv4 = ctx->ifup->ipv4;
+    else if (pdp4 && pdp4->address)
+        ipv4 = pdp4->address;
+    else
+        ipv4 = ctx->cgpaddr_ipv4;
+
+    if (ctx->ifup && ctx->ifup->ipv6)
+        ipv6 = ctx->ifup->ipv6;
+    else if (pdp6 && pdp6->address)
+        ipv6 = pdp6->address;
+    else
+        ipv6 = ctx->cgpaddr_ipv6;
+
+    result = g_slice_new0 (IpConfigResult);
+
+    if ((ctx->ip_family & (MM_BEARER_IP_FAMILY_IPV4 | MM_BEARER_IP_FAMILY_IPV4V6)) && ipv4) {
+        result->ipv4 = mm_bearer_ip_config_new ();
+        mm_bearer_ip_config_set_method (result->ipv4, MM_BEARER_IP_METHOD_STATIC);
+        mm_bearer_ip_config_set_address (result->ipv4, ipv4);
+        /* Point-to-point link: the PDN address alone, no gateway */
+        mm_bearer_ip_config_set_prefix (result->ipv4, 32);
+        if (dns4->len > 1)
+            mm_bearer_ip_config_set_dns (result->ipv4, (const gchar **) dns4->pdata);
+        if (pdp4 && pdp4->mtu)
+            mm_bearer_ip_config_set_mtu (result->ipv4, pdp4->mtu);
+        mm_obj_info (self, "IPv4: %s/32, %u DNS server(s)", ipv4, dns4->len - 1);
+    }
+
+    if ((ctx->ip_family & (MM_BEARER_IP_FAMILY_IPV6 | MM_BEARER_IP_FAMILY_IPV4V6)) &&
+        (ipv6 || pdp6 || dns6->len > 1)) {
+        g_autoptr(GInetAddress) addr = NULL;
+
+        if (ipv6)
+            addr = g_inet_address_new_from_string (ipv6);
+
+        result->ipv6 = mm_bearer_ip_config_new ();
+        if (addr && !g_inet_address_get_is_link_local (addr) && pdp6 && pdp6->gateway) {
+            mm_bearer_ip_config_set_method (result->ipv6, MM_BEARER_IP_METHOD_STATIC);
+            mm_bearer_ip_config_set_address (result->ipv6, ipv6);
+            mm_bearer_ip_config_set_prefix (result->ipv6, pdp6->prefix ? pdp6->prefix : 64);
+            mm_bearer_ip_config_set_gateway (result->ipv6, pdp6->gateway);
+        } else {
+            /* NetworkManager refuses static IPv6 without a gateway. The prefix
+             * comes in a router advertisement (SLAAC); a link-local address
+             * gives the interface identifier the network expects. */
+            mm_bearer_ip_config_set_method (result->ipv6, MM_BEARER_IP_METHOD_DHCP);
+            if (addr && g_inet_address_get_is_link_local (addr)) {
+                mm_bearer_ip_config_set_address (result->ipv6, ipv6);
+                mm_bearer_ip_config_set_prefix (result->ipv6, 64);
+            }
+        }
+        if (dns6->len > 1)
+            mm_bearer_ip_config_set_dns (result->ipv6, (const gchar **) dns6->pdata);
+        mm_obj_info (self, "IPv6: %s, %u DNS server(s)", ipv6 ? ipv6 : "SLAAC", dns6->len - 1);
+    }
+
+    if (!result->ipv4 && !result->ipv6) {
+        ip_config_result_free (result);
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "No IP address reported for PDP context %u", ctx->cid);
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_return_pointer (task, result, (GDestroyNotify) ip_config_result_free);
+    g_object_unref (task);
+}
+
+static void
+cgpaddr_ready (MMBaseModem  *modem,
+               GAsyncResult *res,
+               GTask        *task)
+{
+    IpConfigContext   *ctx;
+    const gchar       *response;
+    g_autoptr(GError)  error = NULL;
+
+    ctx = g_task_get_task_data (task);
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (!response ||
+        !mm_mtk_ccci_parse_cgpaddr_response (response, ctx->cid, &ctx->cgpaddr_ipv4, &ctx->cgpaddr_ipv6, &error))
+        mm_obj_dbg (g_task_get_source_object (task), "couldn't load PDP addresses: %s", error->message);
+    ip_config_complete (task);
+}
+
+static void
+cgcontrdp_ready (MMBaseModem  *modem,
+                 GAsyncResult *res,
+                 GTask        *task)
+{
+    IpConfigContext        *ctx;
+    const gchar            *response;
+    g_autoptr(GError)       error = NULL;
+    g_autofree gchar       *cmd = NULL;
+    const MMMtkCcciPdpInfo *pdp4;
+    gboolean                have_ipv4;
+
+    ctx = g_task_get_task_data (task);
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (response)
+        ctx->pdp_list = mm_mtk_ccci_parse_cgcontrdp_response (response, ctx->cid, &error);
+    if (error)
+        mm_obj_dbg (g_task_get_source_object (task), "couldn't load PDP context parameters: %s", error->message);
+
+    /* +CGCONTRDP on this MD may leave the address empty; +CGPADDR has it */
+    pdp4 = find_pdp_info (ctx->pdp_list, G_SOCKET_FAMILY_IPV4);
+    have_ipv4 = (ctx->ifup && ctx->ifup->ipv4) || (pdp4 && pdp4->address);
+    if (have_ipv4 && !(ctx->ip_family & (MM_BEARER_IP_FAMILY_IPV6 | MM_BEARER_IP_FAMILY_IPV4V6))) {
+        ip_config_complete (task);
+        return;
+    }
+
+    cmd = g_strdup_printf ("+CGPADDR=%u", ctx->cid);
+    mm_base_modem_at_command_full (modem,
+                                   MM_IFACE_PORT_AT (ctx->primary),
+                                   cmd,
+                                   10,
+                                   FALSE, FALSE, NULL,
+                                   (GAsyncReadyCallback) cgpaddr_ready,
+                                   task);
+}
+
+static void
+get_ip_config_3gpp (MMBroadbandBearer   *_self,
+                    MMBroadbandModem    *modem,
+                    MMPortSerialAt      *primary,
+                    MMPortSerialAt      *secondary,
+                    MMPort              *data,
+                    guint                cid,
+                    MMBearerIpFamily     ip_family,
+                    GAsyncReadyCallback  callback,
+                    gpointer             user_data)
+{
+    MMBroadbandBearerMtkCcci *self = MM_BROADBAND_BEARER_MTK_CCCI (_self);
+    IpConfigContext          *ctx;
+    GTask                    *task;
+    g_autofree gchar         *cmd = NULL;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    ctx = g_slice_new0 (IpConfigContext);
+    ctx->modem     = MM_BROADBAND_MODEM_MTK_CCCI (g_object_ref (modem));
+    ctx->primary   = g_object_ref (primary);
+    ctx->cid       = cid;
+    ctx->ip_family = ip_family;
+    if (self->priv->connected)
+        ctx->ifup = mm_mtk_ccci_eif_info_dup (self->priv->connected);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) ip_config_context_free);
+
+    cmd = g_strdup_printf ("+CGCONTRDP=%u", cid);
+    mm_base_modem_at_command_full (MM_BASE_MODEM (modem),
+                                   MM_IFACE_PORT_AT (primary),
+                                   cmd,
+                                   10,
+                                   FALSE, FALSE, NULL,
+                                   (GAsyncReadyCallback) cgcontrdp_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+/* 3GPP disconnection */
+
+static gboolean
+disconnect_3gpp_finish (MMBroadbandBearer  *self,
+                        GAsyncResult       *res,
+                        GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+cgact_deactivate_ready (MMBaseModem  *modem,
+                        GAsyncResult *res,
+                        GTask        *task)
+{
+    g_autoptr(GError) error = NULL;
+
+    /* As in the generic implementation, not fatal: the connection is gone
+     * for ModemManager either way */
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error))
+        mm_obj_warn (g_task_get_source_object (task), "PDP context deactivation failed: %s", error->message);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+disconnect_3gpp (MMBroadbandBearer   *_self,
+                 MMBroadbandModem    *modem,
+                 MMPortSerialAt      *primary,
+                 MMPortSerialAt      *secondary,
+                 MMPort              *data,
+                 guint                cid,
+                 GAsyncReadyCallback  callback,
+                 gpointer             user_data)
+{
+    MMBroadbandBearerMtkCcci *self = MM_BROADBAND_BEARER_MTK_CCCI (_self);
+    GTask                    *task;
+    g_autofree gchar         *cmd = NULL;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    /* The "ifdown" that follows is ours, not a network drop */
+    g_clear_pointer (&self->priv->connected, mm_mtk_ccci_eif_info_free);
+
+    cmd = (cid > 0 ? g_strdup_printf ("+CGACT=0,%u", cid) : g_strdup ("+CGACT=0"));
+    mm_base_modem_at_command_full (MM_BASE_MODEM (modem),
+                                   MM_IFACE_PORT_AT (primary),
+                                   cmd,
+                                   CGACT_TIMEOUT_SECS,
+                                   FALSE, FALSE, NULL,
+                                   (GAsyncReadyCallback) cgact_deactivate_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+
+static void
+report_connection_status (MMBaseBearer             *self,
+                          MMBearerConnectionStatus  status,
+                          const GError             *connection_error)
+{
+    if (status == MM_BEARER_CONNECTION_STATUS_DISCONNECTED)
+        g_clear_pointer (&MM_BROADBAND_BEARER_MTK_CCCI (self)->priv->connected, mm_mtk_ccci_eif_info_free);
+
+    MM_BASE_BEARER_CLASS (mm_broadband_bearer_mtk_ccci_parent_class)->report_connection_status (
+        self, status, connection_error);
+}
+
+/*****************************************************************************/
+
+MMBaseBearer *
+mm_broadband_bearer_mtk_ccci_new_finish (GAsyncResult  *res,
+                                         GError       **error)
+{
+    GObject *bearer;
+    GObject *source;
+
+    source = g_async_result_get_source_object (res);
+    bearer = g_async_initable_new_finish (G_ASYNC_INITABLE (source), res, error);
+    g_object_unref (source);
+
+    if (!bearer)
+        return NULL;
+
+    /* Only export valid bearers */
+    mm_base_bearer_export (MM_BASE_BEARER (bearer));
+
+    return MM_BASE_BEARER (bearer);
+}
+
+void
+mm_broadband_bearer_mtk_ccci_new (MMBroadbandModemMtkCcci *modem,
+                                  MMBearerProperties      *config,
+                                  GCancellable            *cancellable,
+                                  GAsyncReadyCallback      callback,
+                                  gpointer                 user_data)
+{
+    g_async_initable_new_async (
+        MM_TYPE_BROADBAND_BEARER_MTK_CCCI,
+        G_PRIORITY_DEFAULT,
+        cancellable,
+        callback,
+        user_data,
+        MM_BASE_BEARER_MODEM,  modem,
+        MM_BASE_BEARER_CONFIG, config,
+        NULL);
+}
+
+static void
+constructed (GObject *object)
+{
+    g_autoptr(MMBaseModem) modem = NULL;
+
+    G_OBJECT_CLASS (mm_broadband_bearer_mtk_ccci_parent_class)->constructed (object);
+
+    g_object_get (object, MM_BASE_BEARER_MODEM, &modem, NULL);
+    if (modem)
+        g_signal_connect_object (modem,
+                                 MM_BROADBAND_MODEM_MTK_CCCI_SIGNAL_EIF,
+                                 G_CALLBACK (modem_eif_report),
+                                 object,
+                                 0);
+}
+
+static void
+finalize (GObject *object)
+{
+    MMBroadbandBearerMtkCcci *self = MM_BROADBAND_BEARER_MTK_CCCI (object);
+
+    g_clear_pointer (&self->priv->connected, mm_mtk_ccci_eif_info_free);
+
+    G_OBJECT_CLASS (mm_broadband_bearer_mtk_ccci_parent_class)->finalize (object);
+}
+
+static void
+mm_broadband_bearer_mtk_ccci_init (MMBroadbandBearerMtkCcci *self)
+{
+    self->priv = mm_broadband_bearer_mtk_ccci_get_instance_private (self);
+}
+
+static void
+mm_broadband_bearer_mtk_ccci_class_init (MMBroadbandBearerMtkCcciClass *klass)
+{
+    GObjectClass           *object_class           = G_OBJECT_CLASS (klass);
+    MMBaseBearerClass      *base_bearer_class      = MM_BASE_BEARER_CLASS (klass);
+    MMBroadbandBearerClass *broadband_bearer_class = MM_BROADBAND_BEARER_CLASS (klass);
+
+    object_class->constructed = constructed;
+    object_class->finalize    = finalize;
+
+    base_bearer_class->report_connection_status = report_connection_status;
+
+    broadband_bearer_class->dial_3gpp                 = dial_3gpp;
+    broadband_bearer_class->dial_3gpp_finish          = dial_3gpp_finish;
+    broadband_bearer_class->get_ip_config_3gpp        = get_ip_config_3gpp;
+    broadband_bearer_class->get_ip_config_3gpp_finish = get_ip_config_3gpp_finish;
+    broadband_bearer_class->disconnect_3gpp           = disconnect_3gpp;
+    broadband_bearer_class->disconnect_3gpp_finish    = disconnect_3gpp_finish;
+}
