+static void
+test_cgcontrdp_measured (void)
+{
+    GList                  *list;
+    const MMMtkCcciPdpInfo *info;
+    g_autoptr(GError)       error = NULL;
+
+    /* Empty local address, DNS servers in fields 6 and 7 */
+    list = mm_mtk_ccci_parse_cgcontrdp_response (
+        "+CGCONTRDP: 1,5,\"zap.vivo.com.br\",\"\",\"\",\"200.222.108.241\",\"200.222.108.240\",\"\",\"\",0,0\r\n",
+        1, &error);
+    g_assert_no_error (error);
+    g_assert_cmpuint (g_list_length (list), ==, 1);
+    info = list->data;
+    g_assert_cmpuint (info->cid, ==, 1);
+    g_assert_cmpuint (info->bearer_id, ==, 5);
+    g_assert_cmpstr (info->apn, ==, "zap.vivo.com.br");
+    g_assert_cmpint (info->family, ==, G_SOCKET_FAMILY_IPV4);
+    g_assert_null (info->address);
+    g_assert_null (info->gateway);
+    g_assert_cmpstr (info->dns[0], ==, "200.222.108.241");
+    g_assert_cmpstr (info->dns[1], ==, "200.222.108.240");
+    g_assert_null (info->dns[2]);
+    g_assert_cmpuint (info->mtu, ==, 0);
+    mm_mtk_ccci_pdp_info_list_free (list);
+}
