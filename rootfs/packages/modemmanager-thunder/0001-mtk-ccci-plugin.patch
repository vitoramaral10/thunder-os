diff --git c/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.c i/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.c
new file mode 100644
index 0000000..c7f96fd
--- /dev/null
+++ i/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.c
@@ -0,0 +1,599 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 Thunder OS contributors
+ */
+
+#include <config.h>
+
+#include <string.h>
+
+#include <ModemManager.h>
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-modem-helpers.h"
+#include "mm-modem-helpers-mtk-ccci.h"
+
+/*****************************************************************************/
+
+gchar **
+mm_mtk_ccci_split_fields (const gchar *str)
+{
+    GPtrArray *fields;
+    GString   *current;
+    gboolean   in_quotes = FALSE;
+    const gchar *p;
+
+    fields  = g_ptr_array_new ();
+    current = g_string_new (NULL);
+
+    for (p = str ? str : ""; *p; p++) {
+        if (*p == '"') {
+            in_quotes = !in_quotes;
+            continue;
+        }
+        if (*p == ',' && !in_quotes) {
+            g_ptr_array_add (fields, g_strstrip (g_string_free (current, FALSE)));
+            current = g_string_new (NULL);
+            continue;
+        }
+        if (*p == '\r' || *p == '\n')
+            continue;
+        g_string_append_c (current, *p);
+    }
+    g_ptr_array_add (fields, g_strstrip (g_string_free (current, FALSE)));
+    g_ptr_array_add (fields, NULL);
+
+    return (gchar **) g_ptr_array_free (fields, FALSE);
+}
+
+/*****************************************************************************/
+
+/* Number of leading one bits of a netmask; 0 if the mask is not contiguous */
+static guint
+mask_to_prefix (const guint8 *mask,
+                guint         len)
+{
+    guint    prefix = 0;
+    gboolean zero_seen = FALSE;
+    guint    i;
+    gint     bit;
+
+    for (i = 0; i < len; i++) {
+        for (bit = 7; bit >= 0; bit--) {
+            if (mask[i] & (1 << bit)) {
+                if (zero_seen)
+                    return 0;
+                prefix++;
+            } else
+                zero_seen = TRUE;
+        }
+    }
+    return prefix;
+}
+
+gboolean
+mm_mtk_ccci_parse_ip_address (const gchar    *str,
+                              GSocketFamily  *out_family,
+                              gchar         **out_address,
+                              guint          *out_prefix)
+{
+    g_autofree gchar        *copy = NULL;
+    g_autoptr(GInetAddress)  addr = NULL;
+    gchar                   *slash;
+    guint                    prefix = 0;
+    guint                    max_prefix;
+
+    if (!str)
+        return FALSE;
+
+    copy = g_strdup (str);
+    g_strstrip (copy);
+    g_strdelimit (copy, "\"", ' ');
+    g_strstrip (copy);
+    if (!copy[0])
+        return FALSE;
+
+    slash = strchr (copy, '/');
+    if (slash) {
+        *slash = '\0';
+        if (!mm_get_uint_from_str (slash + 1, &prefix))
+            return FALSE;
+        g_strstrip (copy);
+    }
+
+    if (strchr (copy, ':')) {
+        addr = g_inet_address_new_from_string (copy);
+        max_prefix = 128;
+    } else {
+        g_auto(GStrv) octets = NULL;
+        guint8        bytes[32];
+        guint         n;
+        guint         i;
+
+        octets = g_strsplit (copy, ".", -1);
+        n = g_strv_length (octets);
+        if (n != 4 && n != 8 && n != 16 && n != 32)
+            return FALSE;
+
+        for (i = 0; i < n; i++) {
+            guint value;
+
+            if (!mm_get_uint_from_str (octets[i], &value) || value > 255)
+                return FALSE;
+            bytes[i] = (guint8) value;
+        }
+
+        if (n == 4 || n == 8) {
+            addr = g_inet_address_new_from_bytes (bytes, G_SOCKET_FAMILY_IPV4);
+            max_prefix = 32;
+        } else {
+            addr = g_inet_address_new_from_bytes (bytes, G_SOCKET_FAMILY_IPV6);
+            max_prefix = 128;
+        }
+
+        /* Address followed by its mask */
+        if (!slash && (n == 8 || n == 32))
+            prefix = mask_to_prefix (&bytes[n / 2], n / 2);
+    }
+
+    if (!addr || g_inet_address_get_is_any (addr) || prefix > max_prefix)
+        return FALSE;
+
+    if (out_family)
+        *out_family = g_inet_address_get_family (addr);
+    if (out_address)
+        *out_address = g_inet_address_to_string (addr);
+    if (out_prefix)
+        *out_prefix = prefix;
+    return TRUE;
+}
+
+/*****************************************************************************/
+/* +EIF */
+
+void
+mm_mtk_ccci_eif_info_clear (MMMtkCcciEifInfo *info)
+{
+    g_clear_pointer (&info->event_str, g_free);
+    g_clear_pointer (&info->ipv4, g_free);
+    g_clear_pointer (&info->ipv6, g_free);
+}
+
+MMMtkCcciEifInfo *
+mm_mtk_ccci_eif_info_dup (const MMMtkCcciEifInfo *info)
+{
+    MMMtkCcciEifInfo *copy;
+
+    copy = g_new0 (MMMtkCcciEifInfo, 1);
+    *copy = *info;
+    copy->event_str = g_strdup (info->event_str);
+    copy->ipv4 = g_strdup (info->ipv4);
+    copy->ipv6 = g_strdup (info->ipv6);
+    return copy;
+}
+
+void
+mm_mtk_ccci_eif_info_free (MMMtkCcciEifInfo *info)
+{
+    if (!info)
+        return;
+    mm_mtk_ccci_eif_info_clear (info);
+    g_free (info);
+}
+
+gchar *
+mm_mtk_ccci_build_net_port_name (guint trans_intf_id)
+{
+    return g_strdup_printf ("ccmni%u", trans_intf_id % MM_MTK_CCCI_TRANS_INTF_ID_DIVISOR);
+}
+
+gboolean
+mm_mtk_ccci_eif_same_interface (const MMMtkCcciEifInfo *up,
+                                const MMMtkCcciEifInfo *report)
+{
+    if (up->trans_intf_id == report->trans_intf_id)
+        return TRUE;
+    return (report->trans_intf_id < MM_MTK_CCCI_TRANS_INTF_ID_DIVISOR &&
+            report->interface_index == up->interface_index);
+}
+
+static void
+eif_store_address (MMMtkCcciEifInfo *info,
+                   const gchar      *field)
+{
+    GSocketFamily     family;
+    g_autofree gchar *address = NULL;
+
+    if (!mm_mtk_ccci_parse_ip_address (field, &family, &address, NULL))
+        return;
+
+    if (family == G_SOCKET_FAMILY_IPV4 && !info->ipv4)
+        info->ipv4 = g_steal_pointer (&address);
+    else if (family == G_SOCKET_FAMILY_IPV6 && !info->ipv6)
+        info->ipv6 = g_steal_pointer (&address);
+}
+
+gboolean
+mm_mtk_ccci_parse_eif (const gchar       *str,
+                       MMMtkCcciEifInfo  *out_info,
+                       GError           **error)
+{
+    g_auto(GStrv)    fields = NULL;
+    MMMtkCcciEifInfo info = { 0 };
+    guint            n;
+    guint            i;
+
+    g_assert (out_info);
+
+    if (!str) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS, "Missing +EIF payload");
+        return FALSE;
+    }
+
+    fields = mm_mtk_ccci_split_fields (mm_strip_tag (str, "+EIF:"));
+    n = g_strv_length (fields);
+    if (n < 2 || !fields[1][0]) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                     "Couldn't parse +EIF: '%s': too few fields", str);
+        return FALSE;
+    }
+
+    if (!mm_get_uint_from_str (fields[0], &info.trans_intf_id)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                     "Couldn't parse +EIF: '%s': invalid interface id", str);
+        return FALSE;
+    }
+    info.interface_index = info.trans_intf_id % MM_MTK_CCCI_TRANS_INTF_ID_DIVISOR;
+
+    info.event_str = g_ascii_strdown (fields[1], -1);
+    if (g_str_equal (info.event_str, "ifup"))
+        info.event = MM_MTK_CCCI_EIF_EVENT_IFUP;
+    else if (g_str_equal (info.event_str, "ifdown"))
+        info.event = MM_MTK_CCCI_EIF_EVENT_IFDOWN;
+    else if (g_str_equal (info.event_str, "ifchg") || g_str_equal (info.event_str, "ifchange"))
+        info.event = MM_MTK_CCCI_EIF_EVENT_IFCHG;
+    else
+        info.event = MM_MTK_CCCI_EIF_EVENT_UNKNOWN;
+
+    if (n > 2 && fields[2][0] && mm_get_uint_from_str (fields[2], &info.cid))
+        info.has_cid = TRUE;
+
+    for (i = 3; i < n && i < 5; i++)
+        eif_store_address (&info, fields[i]);
+
+    *out_info = info;
+    return TRUE;
+}
+
+/*****************************************************************************/
+/* +ECPI */
+
+void
+mm_mtk_ccci_ecpi_info_clear (MMMtkCcciEcpiInfo *info)
+{
+    g_clear_pointer (&info->number, g_free);
+}
+
+gboolean
+mm_mtk_ccci_parse_ecpi (const gchar        *str,
+                        MMMtkCcciEcpiInfo  *out_info,
+                        GError            **error)
+{
+    g_auto(GStrv)     fields = NULL;
+    MMMtkCcciEcpiInfo info = { 0 };
+    guint             n;
+
+    g_assert (out_info);
+
+    if (!str) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS, "Missing +ECPI payload");
+        return FALSE;
+    }
+
+    fields = mm_mtk_ccci_split_fields (mm_strip_tag (str, "+ECPI:"));
+    n = g_strv_length (fields);
+    if (n < 2 ||
+        !mm_get_uint_from_str (fields[0], &info.call_id) ||
+        !mm_get_uint_from_str (fields[1], &info.msg_type)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                     "Couldn't parse +ECPI: '%s'", str);
+        return FALSE;
+    }
+
+    if (n > 4 && fields[4][0] && mm_get_uint_from_str (fields[4], &info.dir))
+        info.has_dir = TRUE;
+    if (n > 6 && fields[6][0])
+        info.number = g_strdup (fields[6]);
+    if (n > 9 && fields[9][0] && mm_get_uint_from_str (fields[9], &info.cause))
+        info.has_cause = TRUE;
+
+    *out_info = info;
+    return TRUE;
+}
+
+/*
+ * +ECPI message types, as documented in MediaTek's RIL (ril_cc.c, "CSMCC"
+ * messages) and confirmed by the strings of the stock libmtk-ril.so
+ * (handleECPI133Received, "notify ECPI 0" on incoming call ring):
+ *
+ *     0  SETUP                       MT call setup (ring)
+ *     1  DISCONNECT                  network disconnect indication
+ *     2  ALERT                       MO call alerting (remote ringing)
+ *     3  CALL_PROCESS                MO call proceeding
+ *     4  SYNC                        channel/codec synchronization
+ *     5  PROGRESS                    MO call progress (in-band tones)
+ *     6  CALL_CONNECTED              call connected
+ *   129  ALL_CALLS_DISC              all calls disconnected
+ *   130  MO_CALL_ID_ASSIGN           MO call id assigned (dialing)
+ *   131  STATE_CHANGE_HELD           call put on hold
+ *   132  STATE_CHANGE_ACTIVE         call active (retrieved/answered)
+ *   133  STATE_CHANGE_DISCONNECTED   call released
+ *   134  STATE_CHANGE_MO_DISCONNECTING  MO release in progress
+ *
+ * Only the messages that imply one definite state are mapped. Progress
+ * reports (3, 4, 5) may arrive after ALERT and must not move a call back to
+ * DIALING; 0, 1, 129 and 134 are resolved by reloading the +CLCC list, which
+ * also tells RINGING_IN apart from WAITING.
+ */
+MMCallState
+mm_mtk_ccci_ecpi_msg_type_to_call_state (guint            msg_type,
+                                         MMCallDirection *out_direction)
+{
+    MMCallDirection direction = MM_CALL_DIRECTION_UNKNOWN;
+    MMCallState     state;
+
+    switch (msg_type) {
+    case 130:
+        state = MM_CALL_STATE_DIALING;
+        direction = MM_CALL_DIRECTION_OUTGOING;
+        break;
+    case 2:
+        state = MM_CALL_STATE_RINGING_OUT;
+        direction = MM_CALL_DIRECTION_OUTGOING;
+        break;
+    case 6:
+    case 132:
+        state = MM_CALL_STATE_ACTIVE;
+        break;
+    case 131:
+        state = MM_CALL_STATE_HELD;
+        break;
+    case 133:
+        state = MM_CALL_STATE_TERMINATED;
+        break;
+    default:
+        state = MM_CALL_STATE_UNKNOWN;
+        break;
+    }
+
+    if (out_direction)
+        *out_direction = direction;
+    return state;
+}
+
+/*****************************************************************************/
+/* +CGCONTRDP */
+
+static void
+pdp_info_free (MMMtkCcciPdpInfo *info)
+{
+    guint i;
+
+    g_free (info->apn);
+    g_free (info->address);
+    g_free (info->gateway);
+    for (i = 0; i < G_N_ELEMENTS (info->dns); i++)
+        g_free (info->dns[i]);
+    g_free (info);
+}
+
+void
+mm_mtk_ccci_pdp_info_list_free (GList *list)
+{
+    g_list_free_full (list, (GDestroyNotify) pdp_info_free);
+}
+
+static gboolean
+field_is_plain_ipv4 (const gchar *field)
+{
+    g_auto(GStrv) octets = NULL;
+
+    if (!field || !field[0] || strchr (field, ':') || strchr (field, '/'))
+        return FALSE;
+    octets = g_strsplit (field, ".", -1);
+    return g_strv_length (octets) == 4;
+}
+
+/* Old (< 27.007 v9.4.0) format: "<addr>","<mask>" in two fields */
+static gboolean
+field_is_ipv4_netmask (const gchar *field)
+{
+    g_auto(GStrv) octets = NULL;
+    guint8        bytes[4];
+    guint         i;
+
+    if (!field_is_plain_ipv4 (field))
+        return FALSE;
+    octets = g_strsplit (field, ".", -1);
+    for (i = 0; i < 4; i++) {
+        guint value;
+
+        if (!mm_get_uint_from_str (octets[i], &value) || value > 255)
+            return FALSE;
+        bytes[i] = (guint8) value;
+    }
+    /* A netmask starts with 255 and is contiguous */
+    return (bytes[0] == 255 && mask_to_prefix (bytes, 4) > 0);
+}
+
+GList *
+mm_mtk_ccci_parse_cgcontrdp_response (const gchar  *response,
+                                      guint         cid,
+                                      GError      **error)
+{
+    g_auto(GStrv)  lines = NULL;
+    GList         *list = NULL;
+    guint          i;
+
+    if (!response) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS, "Missing +CGCONTRDP response");
+        return NULL;
+    }
+
+    lines = g_strsplit_set (response, "\r\n", -1);
+    for (i = 0; lines[i]; i++) {
+        g_auto(GStrv)     fields = NULL;
+        MMMtkCcciPdpInfo *info;
+        const gchar      *line;
+        guint             n;
+        guint             line_cid;
+        gboolean          old_format;
+        guint             gw_idx;
+        guint             dns_idx;
+        guint             n_dns = 0;
+        guint             j;
+
+        line = g_strstrip (lines[i]);
+        if (!g_str_has_prefix (line, "+CGCONTRDP:"))
+            continue;
+
+        fields = mm_mtk_ccci_split_fields (mm_strip_tag (line, "+CGCONTRDP:"));
+        n = g_strv_length (fields);
+        if (n < 1 || !mm_get_uint_from_str (fields[0], &line_cid) || line_cid != cid)
+            continue;
+
+        info = g_new0 (MMMtkCcciPdpInfo, 1);
+        info->cid = line_cid;
+        info->family = G_SOCKET_FAMILY_INVALID;
+        if (n > 1)
+            mm_get_uint_from_str (fields[1], &info->bearer_id);
+        if (n > 2 && fields[2][0])
+            info->apn = g_strdup (fields[2]);
+
+        old_format = (n > 4 && field_is_plain_ipv4 (fields[3]) && field_is_ipv4_netmask (fields[4]));
+        gw_idx  = old_format ? 5 : 4;
+        dns_idx = gw_idx + 1;
+
+        if (n > 3) {
+            GSocketFamily family;
+
+            if (mm_mtk_ccci_parse_ip_address (fields[3], &family, &info->address, &info->prefix)) {
+                info->family = family;
+                if (old_format) {
+                    g_autofree gchar *mask_with_addr = NULL;
+
+                    mask_with_addr = g_strdup_printf ("%s.%s", fields[3], fields[4]);
+                    mm_mtk_ccci_parse_ip_address (mask_with_addr, NULL, NULL, &info->prefix);
+                }
+            }
+        }
+
+        if (n > gw_idx) {
+            GSocketFamily family;
+
+            if (mm_mtk_ccci_parse_ip_address (fields[gw_idx], &family, &info->gateway, NULL) &&
+                info->family == G_SOCKET_FAMILY_INVALID)
+                info->family = family;
+        }
+
+        for (j = dns_idx; j < n && j < dns_idx + 2; j++) {
+            GSocketFamily family;
+            gchar        *dns = NULL;
+
+            if (!mm_mtk_ccci_parse_ip_address (fields[j], &family, &dns, NULL))
+                continue;
+            info->dns[n_dns++] = dns;
+            if (info->family == G_SOCKET_FAMILY_INVALID)
+                info->family = family;
+        }
+
+        /* <IPv4_MTU> is the 12th field in the current format */
+        if (!old_format && n > 11 && fields[11][0]) {
+            guint mtu;
+
+            if (mm_get_uint_from_str (fields[11], &mtu) && mtu > 0 && mtu <= 65535)
+                info->mtu = mtu;
+        }
+
+        list = g_list_append (list, info);
+    }
+
+    if (!list)
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_NOT_FOUND,
+                     "No +CGCONTRDP information for cid %u", cid);
+    return list;
+}
+
+/*****************************************************************************/
+/* +CGPADDR */
+
+gboolean
+mm_mtk_ccci_parse_cgpaddr_response (const gchar  *response,
+                                    guint         cid,
+                                    gchar       **out_ipv4,
+                                    gchar       **out_ipv6,
+                                    GError      **error)
+{
+    g_auto(GStrv)     lines = NULL;
+    g_autofree gchar *ipv4 = NULL;
+    g_autofree gchar *ipv6 = NULL;
+    gboolean          found = FALSE;
+    guint             i;
+
+    if (!response) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS, "Missing +CGPADDR response");
+        return FALSE;
+    }
+
+    lines = g_strsplit_set (response, "\r\n", -1);
+    for (i = 0; lines[i] && !found; i++) {
+        g_auto(GStrv)  fields = NULL;
+        const gchar   *line;
+        guint          line_cid;
+        guint          j;
+
+        line = g_strstrip (lines[i]);
+        if (!g_str_has_prefix (line, "+CGPADDR:"))
+            continue;
+
+        fields = mm_mtk_ccci_split_fields (mm_strip_tag (line, "+CGPADDR:"));
+        if (!fields[0] || !mm_get_uint_from_str (fields[0], &line_cid) || line_cid != cid)
+            continue;
+
+        found = TRUE;
+        for (j = 1; fields[j] && j < 3; j++) {
+            GSocketFamily     family;
+            g_autofree gchar *address = NULL;
+
+            if (!mm_mtk_ccci_parse_ip_address (fields[j], &family, &address, NULL))
+                continue;
+            if (family == G_SOCKET_FAMILY_IPV4 && !ipv4)
+                ipv4 = g_steal_pointer (&address);
+            else if (family == G_SOCKET_FAMILY_IPV6 && !ipv6)
+                ipv6 = g_steal_pointer (&address);
+        }
+    }
+
+    if (!found) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_NOT_FOUND,
+                     "No +CGPADDR information for cid %u", cid);
+        return FALSE;
+    }
+
+    if (out_ipv4)
+        *out_ipv4 = g_steal_pointer (&ipv4);
+    if (out_ipv6)
+        *out_ipv6 = g_steal_pointer (&ipv6);
+    return TRUE;
+}
diff --git c/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.h i/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.h
new file mode 100644
index 0000000..ebcc554
--- /dev/null
+++ i/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.h
@@ -0,0 +1,138 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 Thunder OS contributors
+ *
+ * Response and URC parsers for MediaTek SoC modems driven over the CCCI
+ * AT channel (vendor kernels: /dev/ttyC0 + ccmniN network devices).
+ */
+
+#ifndef MM_MODEM_HELPERS_MTK_CCCI_H
+#define MM_MODEM_HELPERS_MTK_CCCI_H
+
+#include <glib.h>
+#include <gio/gio.h>
+
+#include <ModemManager.h>
+
+/* ccmniN network interfaces are addressed by the low two decimal digits of
+ * the "transaction interface id" reported in +EIF (e.g. 100 -> ccmni0,
+ * 201 -> ccmni1); the upper digits are a transaction counter. */
+#define MM_MTK_CCCI_TRANS_INTF_ID_DIVISOR 100
+
+/* Split a comma separated AT response/URC payload into fields. Quotes are
+ * honoured (commas inside quotes do not split) and removed; leading and
+ * trailing whitespace is stripped from every field. Never returns NULL. */
+gchar **mm_mtk_ccci_split_fields (const gchar *str);
+
+/* Parse an IPv4/IPv6 address in any of the forms used by 3GPP TS 27.007:
+ *   "a.b.c.d", "a.b.c.d.m1.m2.m3.m4" (address + mask), 16 dotted decimal
+ *   octets (IPv6, +CGPIAF=0 style), 32 dotted decimal octets (IPv6 + mask),
+ *   RFC 5952 colon notation, optionally followed by "/<prefix>".
+ * Unspecified addresses (0.0.0.0, ::) and empty strings return FALSE.
+ * On success the address is returned in canonical text form; the prefix is
+ * 0 when the input did not carry a mask. */
+gboolean mm_mtk_ccci_parse_ip_address (const gchar     *str,
+                                       GSocketFamily   *out_family,
+                                       gchar          **out_address,
+                                       guint           *out_prefix);
+
+/*****************************************************************************/
+/* +EIF: <trans_intf_id>, <event>[, <cid>[, <ipv4>[, <ipv6 or 0>...]]] */
+
+typedef enum {
+    MM_MTK_CCCI_EIF_EVENT_UNKNOWN = 0,
+    MM_MTK_CCCI_EIF_EVENT_IFUP,
+    MM_MTK_CCCI_EIF_EVENT_IFDOWN,
+    MM_MTK_CCCI_EIF_EVENT_IFCHG,
+} MMMtkCcciEifEvent;
+
+typedef struct {
+    guint              trans_intf_id;
+    guint              interface_index;   /* ccmni<interface_index> */
+    MMMtkCcciEifEvent  event;
+    gchar             *event_str;
+    gboolean           has_cid;
+    guint              cid;
+    gchar             *ipv4;              /* NULL if absent or 0.0.0.0 */
+    gchar             *ipv6;              /* NULL if absent */
+} MMMtkCcciEifInfo;
+
+gboolean          mm_mtk_ccci_parse_eif      (const gchar       *str,
+                                              MMMtkCcciEifInfo  *out_info,
+                                              GError           **error);
+void              mm_mtk_ccci_eif_info_clear (MMMtkCcciEifInfo  *info);
+MMMtkCcciEifInfo *mm_mtk_ccci_eif_info_dup   (const MMMtkCcciEifInfo *info);
+void              mm_mtk_ccci_eif_info_free  (MMMtkCcciEifInfo  *info);
+gchar            *mm_mtk_ccci_build_net_port_name (guint trans_intf_id);
+
+/* TRUE if 'report' (e.g. an "ifdown") refers to the interface brought up by
+ * 'up'. The full transaction interface id must match; a report carrying only
+ * the interface index (id < 100) matches by index. */
+gboolean          mm_mtk_ccci_eif_same_interface (const MMMtkCcciEifInfo *up,
+                                                  const MMMtkCcciEifInfo *report);
+
+/*****************************************************************************/
+/* +ECPI: <call_id>,<msg_type>,<is_ibt>,<is_tch>,<dir>,<call_mode>,<number>,
+ *        <toa>,"<pau>"[,<cause>] */
+
+typedef struct {
+    guint     call_id;
+    guint     msg_type;
+    gboolean  has_dir;
+    guint     dir;      /* 0: mobile originated, 1: mobile terminated */
+    gchar    *number;   /* NULL if empty */
+    gboolean  has_cause;
+    guint     cause;
+} MMMtkCcciEcpiInfo;
+
+gboolean mm_mtk_ccci_parse_ecpi      (const gchar        *str,
+                                      MMMtkCcciEcpiInfo  *out_info,
+                                      GError            **error);
+void     mm_mtk_ccci_ecpi_info_clear (MMMtkCcciEcpiInfo  *info);
+
+/* Map an +ECPI message type to the MM call state it implies. Returns
+ * MM_CALL_STATE_UNKNOWN when the message carries no definite state and the
+ * call list must be reloaded (+CLCC) instead. *out_direction is set when the
+ * message type implies one. */
+MMCallState mm_mtk_ccci_ecpi_msg_type_to_call_state (guint             msg_type,
+                                                     MMCallDirection  *out_direction);
+
+/*****************************************************************************/
+/* +CGCONTRDP=<cid> and +CGPADDR=<cid> */
+
+typedef struct {
+    guint          cid;
+    guint          bearer_id;
+    gchar         *apn;
+    GSocketFamily  family;       /* G_SOCKET_FAMILY_INVALID if unknown */
+    gchar         *address;      /* NULL if not reported */
+    guint          prefix;       /* 0 if not reported */
+    gchar         *gateway;      /* NULL if not reported */
+    gchar         *dns[3];       /* NULL terminated, up to 2 entries */
+    guint          mtu;          /* 0 if not reported */
+} MMMtkCcciPdpInfo;
+
+/* Returns a list of MMMtkCcciPdpInfo, one per response line for the given
+ * cid (dual stack contexts report one IPv4 and one IPv6 line). */
+GList   *mm_mtk_ccci_parse_cgcontrdp_response (const gchar  *response,
+                                               guint         cid,
+                                               GError      **error);
+void     mm_mtk_ccci_pdp_info_list_free       (GList        *list);
+
+gboolean mm_mtk_ccci_parse_cgpaddr_response   (const gchar  *response,
+                                               guint         cid,
+                                               gchar       **out_ipv4,
+                                               gchar       **out_ipv6,
+                                               GError      **error);
+
+#endif /* MM_MODEM_HELPERS_MTK_CCCI_H */
diff --git c/src/plugins/mtk-ccci/mm-plugin-mtk-ccci.c i/src/plugins/mtk-ccci/mm-plugin-mtk-ccci.c
new file mode 100644
index 0000000..a172d16
--- /dev/null
+++ i/src/plugins/mtk-ccci/mm-plugin-mtk-ccci.c
@@ -0,0 +1,100 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 Thunder OS contributors
+ *
+ * Plugin for the MediaTek SoC modem (MD1) of vendor kernels, reached through
+ * the CCCI AT tty and the ccmniN network devices. The ports carry no USB or
+ * PCI ids: they are claimed by the udev tag ID_MM_MTK_CCCI and grouped into
+ * one modem by ID_MM_PHYSDEV_UID (77-mm-mtk-ccci.rules), the same scheme as
+ * the qcom-soc plugin and the MT6895-Mainline mtk-soc fork.
+ */
+
+#include <gmodule.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-plugin-common.h"
+#include "mm-broadband-modem-mtk-ccci.h"
+#include "mm-log-object.h"
+
+#define MM_TYPE_PLUGIN_MTK_CCCI mm_plugin_mtk_ccci_get_type ()
+MM_DEFINE_PLUGIN (MTK_CCCI, mtk_ccci, MtkCcci)
+
+/*****************************************************************************/
+
+static MMBaseModem *
+create_modem (MMPlugin     *self,
+              const gchar  *uid,
+              const gchar  *physdev,
+              const gchar **drivers,
+              guint16       vendor,
+              guint16       product,
+              guint16       subsystem_vendor,
+              guint16       subsystem_device,
+              GList        *probes,
+              GError      **error)
+{
+    mm_obj_dbg (self, "MediaTek CCCI modem found...");
+    return MM_BASE_MODEM (mm_broadband_modem_mtk_ccci_new (uid,
+                                                           physdev,
+                                                           drivers,
+                                                           mm_plugin_get_name (self),
+                                                           vendor,
+                                                           product));
+}
+
+/*****************************************************************************/
+
+MM_PLUGIN_NAMED_CREATOR_SCOPE MMPlugin *
+mm_plugin_create_mtk_ccci (void)
+{
+    static const gchar *subsystems[] = { "tty", "net", NULL };
+    static const gchar *udev_tags[]  = { "ID_MM_MTK_CCCI", NULL };
+
+    return MM_PLUGIN (
+        g_object_new (MM_TYPE_PLUGIN_MTK_CCCI,
+                      MM_PLUGIN_NAME,               MM_MODULE_NAME,
+                      MM_PLUGIN_ALLOWED_SUBSYSTEMS, subsystems,
+                      MM_PLUGIN_ALLOWED_UDEV_TAGS,  udev_tags,
+                      MM_PLUGIN_ALLOWED_AT,         TRUE,
+                      /* Whole-line writes during probing too (CCCI is
+                       * message based), see setup_ports() in the modem */
+                      MM_PLUGIN_SEND_DELAY,         (guint64) 0,
+                      /* There is no QMI, MBIM or XMM RPC here. Allowing them
+                       * only disables the implicit "forbidden QMI/MBIM
+                       * driver" filter, which otherwise needs a kernel
+                       * driver name and drops the port when there is none:
+                       * the vendor ccmni devices have no parent device
+                       * (/sys/devices/virtual/net) and the CCCI tty may not
+                       * either. Nothing is probed for those protocols on tty
+                       * or net ports, and the udev tag still restricts the
+                       * plugin to the CCCI ports. */
+                      MM_PLUGIN_ALLOWED_QMI,        TRUE,
+                      MM_PLUGIN_ALLOWED_MBIM,       TRUE,
+                      MM_PLUGIN_ALLOWED_XMMRPC,     TRUE,
+                      NULL));
+}
+
+static void
+mm_plugin_mtk_ccci_init (MMPluginMtkCcci *self)
+{
+}
+
+static void
+mm_plugin_mtk_ccci_class_init (MMPluginMtkCcciClass *klass)
+{
+    MMPluginClass *plugin_class = MM_PLUGIN_CLASS (klass);
+
+    plugin_class->create_modem = create_modem;
+}
