+/*****************************************************************************/
+/* +COPS AcT: the generic parser handles the values this MD reports */
+
+static void
+test_cops_act (void)
+{
+    static const struct {
+        const gchar             *response;
+        MMModemAccessTechnology  act;
+    } tests[] = {
+        /* As measured: VIVO 4G with an NR anchor */
+        { "+COPS: 0,0,\"VIVO\",13", MM_MODEM_ACCESS_TECHNOLOGY_LTE | MM_MODEM_ACCESS_TECHNOLOGY_5GNR },
+        { "+COPS: 0,0,\"VIVO\",7",  MM_MODEM_ACCESS_TECHNOLOGY_LTE },
+        { "+COPS: 0,0,\"VIVO\",10", MM_MODEM_ACCESS_TECHNOLOGY_LTE },
+        { "+COPS: 0,0,\"VIVO\",11", MM_MODEM_ACCESS_TECHNOLOGY_5GNR },
+        { "+COPS: 0,0,\"VIVO\",2",  MM_MODEM_ACCESS_TECHNOLOGY_UMTS },
+        { "+COPS: 0,0,\"VIVO\",0",  MM_MODEM_ACCESS_TECHNOLOGY_GSM },
+    };
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS (tests); i++) {
+        g_autoptr(GError)        error = NULL;
+        g_autofree gchar        *operator = NULL;
+        guint                    mode = G_MAXUINT;
+        guint                    format = G_MAXUINT;
+        MMModemAccessTechnology  act = MM_MODEM_ACCESS_TECHNOLOGY_UNKNOWN;
+
