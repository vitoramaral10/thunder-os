# Userspace da conectividade MediaTek WMT (SoC CONNAC 1.0): o wmt_loader, o wmt_launcher
# e o wlan_assistant do Android num programa so (thunder-wmt), com as units do systemd.
# Generico: o que muda por aparelho vem das WMT_* do device.sh, que o configure.sh grava
# em /etc/thunder/wmt.conf. Pacote do aparelho (DEVICE_LOCAL_PACKAGES): atualiza pelo
# pacman como o linux-<aparelho>.
#
# Fontes locais (esta pasta): o hash da receita no tools/build-rootfs.sh ja cobre a
# integridade, por isso SKIP.
pkgname=thunder-mediatek-wmt
pkgver=1.0.0
pkgrel=3
pkgdesc='Thunder OS: MediaTek WMT connectivity bring-up (loader, launcher, Wi-Fi NVRAM, Bluetooth)'
arch=(any)
url='https://github.com/vitoramaral10/thunder-os'
license=(GPL-3.0-or-later)
# kmod: modprobe; e2fsprogs: debugfs le a NVRAM do ext4 da particao sem montar.
depends=(python kmod e2fsprogs)
source=(thunder_wmt.py test_thunder_wmt.py
	thunder-wmt-connsys.service thunder-wmt-wifi.service thunder-wmt-bt.service
	bluetooth-thunder-wmt.conf)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP)

check() {
	cd "$srcdir"
	python -m unittest -v test_thunder_wmt
}

package() {
	# 0700: o script e tambem o lock do wifi-on/wifi-off; nenhum outro uid pode abri-lo.
	install -Dm700 "$srcdir/thunder_wmt.py" "$pkgdir/usr/lib/thunder/wmt/thunder-wmt"
	install -Dm644 -t "$pkgdir/usr/lib/systemd/system" \
		"$srcdir/thunder-wmt-connsys.service" "$srcdir/thunder-wmt-wifi.service" \
		"$srcdir/thunder-wmt-bt.service"
	install -Dm644 "$srcdir/bluetooth-thunder-wmt.conf" \
		"$pkgdir/usr/lib/systemd/system/bluetooth.service.d/thunder-wmt.conf"
}
