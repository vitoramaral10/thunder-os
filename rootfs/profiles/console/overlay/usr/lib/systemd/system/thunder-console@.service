# Sessao grafica do perfil console para o usuario %i: phoc (compositor) com squeekboard
# e foot (/usr/lib/thunder/console-session), no tty1, como sessao do logind (PAM
# thunder-console -> pam_systemd). O logind entrega DRM e entrada ao phoc pelo libseat
# (backend logind) e sobe o systemd --user do usuario, que da o D-Bus de sessao e o
# XDG_RUNTIME_DIR. Mesmo padrao do greetd/cage: toma o tty1 do getty@tty1.
# Ajuste local (ex.: WLR_RENDERER=pixman para isolar problema de GPU):
#   systemctl edit thunder-console@USUARIO   ->  [Service] Environment=WLR_RENDERER=pixman
[Unit]
Description=Console session (phoc, squeekboard, foot) for %i on tty1
Documentation=file:/usr/lib/thunder/console-session
After=systemd-user-sessions.service systemd-logind.service dbus.socket getty@tty1.service
Wants=dbus.socket
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty0
# Como o OpenRC fazia (respawn_max=5 em 60 s): depois disso a unit fica failed e o SSH
# segue intacto.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=%i
PAMName=thunder-console
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
WorkingDirectory=~
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_SESSION_DESKTOP=phoc
Environment=XDG_CURRENT_DESKTOP=phoc LIBSEAT_BACKEND=logind
# Sessao local: o pam_systemd poe CAP_WAKE_ALARM no conjunto ambiente (systemd 254+), e
# phoc, squeekboard e foot o herdariam. O bwrap sem setuid recusa rodar com capacidade
# ("Unexpected capabilities but not setuid"): os carregadores de imagem do glycin morrem e
# o squeekboard aborta no primeiro icone. Como o phosh.service do Phosh: capsh --noamb.
ExecStart=capsh --noamb -- -c "exec /usr/bin/phoc --no-xwayland -C /etc/phoc/thunder-console.ini -E /usr/lib/thunder/console-session"
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=graphical.target
