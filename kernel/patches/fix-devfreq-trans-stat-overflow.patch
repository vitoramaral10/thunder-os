Backport da correcao upstream de trans_stat_show (Linux 5.x): a tabela de
transicoes (N x N OPPs) era escrita com sprintf sem limite e estourava a
pagina do sysfs com muitos OPPs; um cat derrubava o kernel (Oops em
iov_iter_advance). Com o devfreq do panfrost no MT6833, cabe numa pagina,
mas o limite fica garantido aqui.

--- a/drivers/devfreq/devfreq.c	2026-09-26 16:16:10.024268489 -0300
+++ b/drivers/devfreq/devfreq.c	2026-09-26 17:13:18.767885220 -0300
@@ -1341,31 +1341,31 @@
 	}
 	mutex_unlock(&devfreq->lock);
 
-	len = sprintf(buf, "     From  :   To\n");
-	len += sprintf(buf + len, "           :");
+	len = scnprintf(buf, PAGE_SIZE, "     From  :   To\n");
+	len += scnprintf(buf + len, PAGE_SIZE - len, "           :");
 	for (i = 0; i < max_state; i++)
-		len += sprintf(buf + len, "%10lu",
+		len += scnprintf(buf + len, PAGE_SIZE - len, "%10lu",
 				devfreq->profile->freq_table[i]);
 
-	len += sprintf(buf + len, "   time(ms)\n");
+	len += scnprintf(buf + len, PAGE_SIZE - len, "   time(ms)\n");
 
 	for (i = 0; i < max_state; i++) {
 		if (devfreq->profile->freq_table[i]
 					== devfreq->previous_freq) {
-			len += sprintf(buf + len, "*");
+			len += scnprintf(buf + len, PAGE_SIZE - len, "*");
 		} else {
-			len += sprintf(buf + len, " ");
+			len += scnprintf(buf + len, PAGE_SIZE - len, " ");
 		}
-		len += sprintf(buf + len, "%10lu:",
+		len += scnprintf(buf + len, PAGE_SIZE - len, "%10lu:",
 				devfreq->profile->freq_table[i]);
 		for (j = 0; j < max_state; j++)
-			len += sprintf(buf + len, "%10u",
+			len += scnprintf(buf + len, PAGE_SIZE - len, "%10u",
 				devfreq->trans_table[(i * max_state) + j]);
-		len += sprintf(buf + len, "%10u\n",
+		len += scnprintf(buf + len, PAGE_SIZE - len, "%10u\n",
 			jiffies_to_msecs(devfreq->time_in_state[i]));
 	}
 
-	len += sprintf(buf + len, "Total transition : %u\n",
+	len += scnprintf(buf + len, PAGE_SIZE - len, "Total transition : %u\n",
 					devfreq->total_trans);
 	return len;
 }
