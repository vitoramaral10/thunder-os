# thunder r22: Bluetooth.
#
# O light_defconfig da Xiaomi deixa CONFIG_BT e CONFIG_RFKILL em 'n' porque o
# Android nao usa o BlueZ: a pilha dele e toda em espaco de usuario e fala
# direto com /dev/stpbt. Aqui e o contrario -- o BlueZ do userland PRECISA
# do subsistema no kernel. Sem estas linhas nem /sys/class/bluetooth existe.
#
# O transporte e o btmtk_stp.ko (patch add-btmtk-stp-hci-driver), um driver HCI sobre
# o modo BlueZ do STP; nao ha mais ponte em espaco de usuario nem hci_vhci.
#
# As dependencias de crypto (CMAC, ECDH, SHA256, ECB) sao 'select' do
# CONFIG_BT no Kconfig e o olddefconfig as resolve sozinho.
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# thunder: systemd 262 como PID 1 (build/research/pid1/kernel-config-plan.md, revisao rA).
# FHANDLE: name_to_handle_at (id de cgroup, identidade de inode). CGROUP_PIDS: TasksMax=.
# AUTOFS_FS: units .automount. CHECKPOINT_RESTORE: kcmp (systemd same_fd, Mesa).
# FQ_CODEL: net.core.default_qdisc do systemd. UEVENT_HELPER fica desligado acima: o udev
# usa netlink, e um helper faria fork por uevent.
CONFIG_CGROUP_PIDS=y
CONFIG_AUTOFS_FS=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_NET_SCH_FQ_CODEL=y

# thunder: iwd (AF_ALG e DH do keyring; revisao rC). WPA2/WPA3-Personal; enterprise com TLS
