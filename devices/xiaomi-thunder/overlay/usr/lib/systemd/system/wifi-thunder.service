# Sobe a pilha de Wi-Fi do MT6833 no boot. O CONNSYS nao tem firmware proprio: a cada
# boot o AP copia os ROM patches para a EMI e solta o CPU do radio; no Android quem
# orquestra isso e um daemon do launcher, aqui o sobe-wifi.sh + wmt-daemon.py (log em
# /run/sobe-wifi.log). Leva ~30 s, ate ~200 s no pior caso: por isso vem depois do cabo
# USB e do SSH, e nada espera por ele. O NetworkManager pega a wlan0 quando ela nasce
# (hotplug do udev). Sucesso = a wlan0 existir: o script tem falhas esperadas no caminho
# (ex.: SET_PATCH_NUM na 2a chamada), entao o codigo de saida dele nao conta.
# O wmt-daemon.py (setsid pelo script) segue no cgroup desta unit (RemainAfterExit=yes)
# e sai sozinho depois de 120 s.
[Unit]
Description=Wi-Fi bring-up (MediaTek MT6833 / gen4m)
Documentation=file:/usr/local/bin/sobe-wifi.sh
After=thunder-usb-network.service thunder-telnet-usb.service sshd.service
After=systemd-udev-trigger.service systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/local/bin/sobe-wifi.sh
ExecStart=/usr/bin/test -e /sys/class/net/wlan0
# Desliga o radio. Nunca rmmod wmt_drv: trava em Unloading e prende o desligamento.
ExecStop=-/bin/sh -c '[ ! -e /dev/wmtWifi ] || echo 0 > /dev/wmtWifi'
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
