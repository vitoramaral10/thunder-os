#!/usr/bin/openrc-run
# Sobe a pilha de Wi-Fi do MT6833 no boot.
#
# O CONNSYS nao tem firmware proprio: a cada boot o AP precisa copiar os ROM
# patches para a EMI, liberar a regiao para o barramento do radio e so entao
# soltar o CPU do radio. No Android quem orquestra isso e um daemon do launcher;
# aqui esse papel e do sobe-wifi.sh + wmt-daemon.py.
#
# Fornece "wifi-hw": o wpa-supplicant do nucleo espera por ele. Roda depois do SSH e
# do telnet pelo cabo, para os ~30 s do bring-up nao atrasarem o acesso.

description="Bring-up do Wi-Fi (MediaTek MT6833 / gen4m)"

depend() {
	need localmount
	after sshd telnet-usb usb-network modules
	provide wifi-hw
}

start() {
	ebegin "Subindo o Wi-Fi do MT6833"
	# O bring-up registra tudo em /run/sobe-wifi.log.
	/usr/local/bin/sobe-wifi.sh >/dev/null 2>&1
	# Sucesso = a interface existir. O script nao devolve codigo util porque partes
	# dele falham de forma esperada (ex.: SET_PATCH_NUM na 2a chamada).
	[ -e /sys/class/net/wlan0 ]
	eend $? "Wi-Fi nao subiu; ver /run/sobe-wifi.log"
}

stop() {
	ebegin "Desligando o radio Wi-Fi"
	if [ -e /dev/wmtWifi ]; then
		echo 0 > /dev/wmtWifi 2>/dev/null
	fi
	eend 0
}
