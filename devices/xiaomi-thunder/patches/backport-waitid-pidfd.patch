@@ -17,6 +17,7 @@
 #define P_ALL		0
 #define P_PID		1
 #define P_PGID		2
+#define P_PIDFD		3
 
 
 #endif /* _UAPI_LINUX_WAIT_H */
--- a/kernel/exit.c
+++ b/kernel/exit.c
@@ -1539,6 +1539,23 @@
