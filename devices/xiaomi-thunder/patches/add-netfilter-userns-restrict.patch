diff -ruN a/net/netfilter/core.c b/net/netfilter/core.c
--- a/net/netfilter/core.c
+++ b/net/netfilter/core.c
@@ -24,6 +24,8 @@
 #include <linux/rcupdate.h>
 #include <net/net_namespace.h>
 #include <net/sock.h>
+#include <linux/capability.h>
+#include <linux/sysctl.h>
 
 #include "nf_internals.h"
 
@@ -33,6 +35,20 @@
 DEFINE_PER_CPU(bool, nf_skb_duplicated);
 EXPORT_SYMBOL_GPL(nf_skb_duplicated);
 
+int sysctl_nf_userns_restrict __read_mostly = 1;
+EXPORT_SYMBOL_GPL(sysctl_nf_userns_restrict);
+
+/* Permission for the x_tables/ebtables/ipset/ipvs sockopts: CAP_NET_ADMIN over
+ * @net as upstream and, while restricted, also in the initial user namespace.
+ */
+bool nf_net_admin_capable(const struct net *net)
+{
+	if (!ns_capable(net->user_ns, CAP_NET_ADMIN))
+		return false;
+	return !nf_userns_restricted() || capable(CAP_NET_ADMIN);
+}
+EXPORT_SYMBOL_GPL(nf_net_admin_capable);
+
 #ifdef CONFIG_JUMP_LABEL
 struct static_key nf_hooks_needed[NFPROTO_NUMPROTO][NF_MAX_HOOKS];
 EXPORT_SYMBOL(nf_hooks_needed);
@@ -673,6 +689,41 @@
 	.exit = netfilter_net_exit,
 };
 
+#ifdef CONFIG_SYSCTL
+static int nf_userns_restrict_min;
+static int nf_userns_restrict_max = 1;
+
+/* net_ctl_permissions() lets any CAP_NET_ADMIN holder write net sysctls as if
+ * it were root, so a process with CAP_NET_ADMIN but nothing else could switch
+ * the restriction off. Writes need CAP_SYS_ADMIN in the initial user namespace.
+ */
+static int nf_userns_restrict_handler(struct ctl_table *table, int write,
+				      void __user *buffer, size_t *lenp,
+				      loff_t *ppos)
+{
+	if (write && !capable(CAP_SYS_ADMIN))
+		return -EPERM;
+
+	return proc_dointvec_minmax(table, write, buffer, lenp, ppos);
+}
+
+/* Registered in init_net only: invisible from other network namespaces.
+ * Values 0..1; writes need CAP_SYS_ADMIN (see the handler).
+ */
+static struct ctl_table nf_userns_sysctl_table[] = {
+	{
+		.procname	= "nf_userns_restrict",
+		.data		= &sysctl_nf_userns_restrict,
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= nf_userns_restrict_handler,
+		.extra1		= &nf_userns_restrict_min,
+		.extra2		= &nf_userns_restrict_max,
+	},
+	{ }
+};
+#endif
+
 int __init netfilter_init(void)
 {
 	int ret;
@@ -685,6 +736,13 @@
 	if (ret < 0)
 		goto err_pernet;
 
+#ifdef CONFIG_SYSCTL
+	/* Without the knob the restriction simply stays on. */
+	if (!register_net_sysctl(&init_net, "net/netfilter",
+				 nf_userns_sysctl_table))
+		pr_warn("netfilter: cannot register nf_userns_restrict\n");
+#endif
+
 	return 0;
 err_pernet:
 	unregister_pernet_subsys(&netfilter_net_ops);
