+/*
+ * The GM3.0 fuel gauge algorithm normally runs in the Android fuelgauged
+ * daemon, which talks to this driver over netlink. Recovery has no daemon,
+ * so the driver carries the same algorithm in-kernel (mtk_battery_recovery.c)
+ * for that case. A non-Android userspace has no daemon either: without the
+ * in-kernel algorithm nothing ever sets the UI SOC and the battery reports
+ * capacity -1 forever.
+ */
+static bool fg_use_kernel_algo(void)
+{
+	if (IS_ENABLED(CONFIG_MTK_GAUGE_KERNEL_ALGO) && !is_fg_disabled())
+		return true;
+
+	return is_recovery_mode();
+}
