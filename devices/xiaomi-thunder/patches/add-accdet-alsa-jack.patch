+	/* without pins snd_soc_card_jack_new() adds no control: add them here */
+	if (!ret)
+		ret = snd_jack_add_new_kctl(mt6833_mt6359_hp_jack.jack,
+					    "Headphone Jack",
+					    SND_JACK_HEADPHONE |
+					    SND_JACK_LINEOUT);
+	if (!ret)
+		ret = snd_jack_add_new_kctl(mt6833_mt6359_mic_jack.jack,
+					    "Headset Mic Jack",
+					    SND_JACK_MICROPHONE);
+	if (ret)
+		dev_warn(card->dev, "%s(), jack: %d\n", __func__, ret);
+	else
