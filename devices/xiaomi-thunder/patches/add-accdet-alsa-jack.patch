@@ -1039,6 +1046,32 @@
 			dev_warn(card->dev, "%s(), no route to %s: %d\n",
 				 __func__, sink, ret);
 	}
+
+#ifdef CONFIG_MTK_ACCDET
+	/* thunder: ALSA jack controls for UCM JackControl, fed by accdet */
+	ret = snd_soc_card_jack_new(card, "Headphone Jack",
