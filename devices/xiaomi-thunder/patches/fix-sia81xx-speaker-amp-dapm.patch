+/*
+ * thunder: feed each sia81xx amplifier from the codec lineout, so DAPM powers it
+ * with the playback stream through "LOL Mux" and powers it down after. The aux
+ * devices and their name prefixes come from the DT; a variant without sia81xx
+ * has none, and nothing is added.
+ */
+static int mt6833_mt6359_late_probe(struct snd_soc_card *card)
+{
+	struct snd_soc_dapm_route route = { .source = "LINEOUT L" };
+	char sink[64];
+	int i, ret;
+
+	for (i = 0; i < card->num_configs; i++) {
+		const char *prefix = card->codec_conf[i].name_prefix;
+
+		if (!prefix)
+			continue;
+		snprintf(sink, sizeof(sink), "%s IN", prefix);
+		route.sink = sink;
+		ret = snd_soc_dapm_add_routes(&card->dapm, &route, 1);
+		if (ret)
+			dev_warn(card->dev, "%s(), no route to %s: %d\n",
+				 __func__, sink, ret);
+	}
+	return 0;
+}
+
 static struct snd_soc_card mt6833_mt6359_soc_card = {
 	.name = "mt6833-mt6359",
 	.owner = THIS_MODULE,
@@ -1027,6 +1054,7 @@
 	.num_dapm_widgets = ARRAY_SIZE(mt6833_mt6359_widgets),
 	.dapm_routes = mt6833_mt6359_routes,
 	.num_dapm_routes = ARRAY_SIZE(mt6833_mt6359_routes),
+	.late_probe = mt6833_mt6359_late_probe,
 };
 
