 	return 0;
 }
+
+/*
+ * The touch IC is part of the display (TDDI): powering the panel down resets
+ * it, and it needs nvt_ts_resume() once the panel is back. On Android an FB
+ * blank event reaches the callback above; a plain DRM compositor never emits
+ * one, so after the first blank the touchscreen stayed dead. Follow the
+ * panel's own blank notifications as well. suspend and resume both return
+ * early when the IC is already in that state, so a duplicate is harmless.
+ */
+static int nvt_panel_blank_callback(struct notifier_block *self,
+	unsigned long event, void *data)
+{
+	struct drm_notifier_data *evdata = data;
+	int blank;
+
+	if (event != DRM_EVENT_BLANK || !evdata || !evdata->data || !ts)
+		return 0;
+	blank = *(int *)evdata->data;
+	if (blank == DRM_BLANK_POWERDOWN) {
+		NVT_LOG("panel blank\n");
+		nvt_ts_suspend(&ts->client->dev);
+	} else if (blank == DRM_BLANK_UNBLANK) {
+		NVT_LOG("panel unblank\n");
+		nvt_ts_resume(&ts->client->dev);
+	}
+	return 0;
+}
+
+static struct notifier_block nvt_panel_nb = {
+	.notifier_call = nvt_panel_blank_callback,
+};
 #endif
 #elif defined(CONFIG_HAS_EARLYSUSPEND)
