+/*
+ * thunder: msleep()/usleep_range() in TASK_IDLE. Vendor kthreads sleep in a loop all the
+ * time; TASK_UNINTERRUPTIBLE counts them in the load average (~16 with an idle CPU).
+ * Same timing; usleep_idle_range() is mainline's (5.16), msleep_idle() is ours.
+ */
+void __sched usleep_idle_range(unsigned long min, unsigned long max)
+{
+	ktime_t exp = ktime_add_us(ktime_get(), min);
+	u64 delta = (u64)(max - min) * NSEC_PER_USEC;
+
+	for (;;) {
+		__set_current_state(TASK_IDLE);
+		if (!schedule_hrtimeout_range(&exp, delta, HRTIMER_MODE_ABS))
+			break;
+	}
+}
+EXPORT_SYMBOL(usleep_idle_range);
+
+void __sched msleep_idle(unsigned int msecs)
+{
+	unsigned long timeout = msecs_to_jiffies(msecs) + 1;
+
+	while (timeout)
+		timeout = schedule_timeout_idle(timeout);
+}
+EXPORT_SYMBOL(msleep_idle);
