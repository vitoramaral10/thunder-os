+/*
+ * Backport of 7bc3fa0172a4 ("procfs: allow reading fdinfo with
+ * PTRACE_MODE_READ") and 1927e498aee1 ("procfs: prevent unprivileged
+ * processes accessing fdinfo dir") from 5.14. Without them a process that
+ * dropped privileges without exec() becomes non-dumpable, its /proc files
+ * turn root-owned, and it can no longer read its own fdinfo. polkit >= 124
+ * resolves every subject through a pidfd and reads its PID from
+ * /proc/self/fdinfo, so polkitd saw every caller as PID 0 ("Process not
+ * found") and nothing needing authorization worked, power-off included.
+ */
+static bool proc_fdinfo_access_allowed(struct inode *inode)
+{
+	bool allowed = false;
+	struct task_struct *task = get_proc_task(inode);
+
+	if (!task)
+		return false;
+
+	allowed = ptrace_may_access(task, PTRACE_MODE_READ_FSCREDS);
+	put_task_struct(task);
+
+	return allowed;
+}
+
 static int seq_fdinfo_open(struct inode *inode, struct file *file)
 {
+	if (!proc_fdinfo_access_allowed(inode))
+		return -EACCES;
+
 	return single_open(file, seq_show, inode);
 }
 
