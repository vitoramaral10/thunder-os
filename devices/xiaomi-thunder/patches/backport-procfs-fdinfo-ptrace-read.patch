+/*
+ * proc_fdinfo_permission - check permission for the /proc/<pid>/fdinfo
+ * directory itself
+ */
+static int proc_fdinfo_permission(struct inode *inode, int mask)
+{
+	if ((mask & MAY_READ) && !proc_fdinfo_access_allowed(inode))
+		return -EACCES;
+
+	return generic_permission(inode, mask);
+}
+
 const struct inode_operations proc_fdinfo_inode_operations = {
 	.lookup		= proc_lookupfdinfo,
+	.permission	= proc_fdinfo_permission,
 	.setattr	= proc_setattr,
 };
 
