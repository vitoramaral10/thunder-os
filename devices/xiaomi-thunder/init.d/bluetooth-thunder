#!/sbin/openrc-run
# Sobe o Bluetooth do MT6833 no boot.
#
# O chip de conectividade e' um so': Wi-Fi e Bluetooth dividem o mesmo CONNSYS,
# a mesma EMI e o mesmo wmt_drv.  Por isso este servico depende do wifi-thunder
# -- nao porque o Bluetooth precise de rede, mas porque e' o bring-up do Wi-Fi
# que copia os ROM patches para a EMI e liga o radio.  Com o chip ja' ligado,
# abrir /dev/stpbt apenas soma uma referencia; com o chip desligado, seria
# preciso todo o lancador do WMT de novo.
#
# Quem faz o trabalho e' a ponte: o driver so' entrega um /dev/stpbt, e o BlueZ
# quer um controlador registrado no kernel.  Ver stpbt-vhci-bridge.py.

description="Bring-up do Bluetooth (MediaTek MT6833 / stpbt)"

command="/usr/local/bin/stpbt-vhci-bridge.py"
command_background=true
pidfile="/run/stpbt-vhci-bridge.pid"
output_log="/var/log/bluetooth-thunder.log"
error_log="/var/log/bluetooth-thunder.log"

# A ponte SO' pode ser parada com SIGTERM, e precisa de tempo para fechar os
# descritores em ordem.  Um SIGKILL a pegaria no meio de um read() e deixaria
# o btonflag do driver preso em 1 -- dai em diante /dev/stpbt devolve EIO ate'
# o proximo boot.  Ver o cabecalho de stpbt-vhci-bridge.py.
retry="SIGTERM/20"

BT_ADDR_NV=/lib/firmware/bt_addr.bin

depend() {
    need localmount wifi-thunder
    before bluetooth
    after modules
}

extrai_endereco() {
    # O BD_ADDR de fabrica vive na nvdata, ao lado da calibracao de RF.
    # Montagem SEMPRE somente leitura: essa particao e' insubstituivel.
    [ -s "$BT_ADDR_NV" ] && return 0
    ebegin "Extraindo o endereco Bluetooth da nvdata"
    mkdir -p /mnt/nvdata-ro
    if mount -o ro /dev/disk/by-partlabel/nvdata /mnt/nvdata-ro 2>/dev/null; then
        dd if=/mnt/nvdata-ro/APCFG/APRDEB/BT_Addr of="$BT_ADDR_NV" \
           bs=1 count=6 2>/dev/null
        umount /mnt/nvdata-ro
        chmod 600 "$BT_ADDR_NV"
    fi
    # Nao e' fatal: sem o arquivo o radio sobe com o endereco padrao da
    # MediaTek, que funciona, mas e' igual em toda unidade.
    [ -s "$BT_ADDR_NV" ]
    eend $? "sem endereco de fabrica; o controlador usara' o padrao"
    return 0
}

start_pre() {
    ebegin "Carregando bt_drv_6833"
    modprobe bt_drv_6833
    eend $? || return 1

    # O no e' criado dinamicamente (CREATE_NODE_DYNAMIC=1); dar um tempo ao
    # devtmpfs antes de a ponte tentar abri-lo.
    local i=0
    while [ ! -e /dev/stpbt ] && [ $i -lt 25 ]; do
        sleep 0.2
        i=$((i + 1))
    done
    if [ ! -e /dev/stpbt ]; then
        eerror "/dev/stpbt nao apareceu; bt_drv_6833 carregou?"
        return 1
    fi

    extrai_endereco
    return 0
}

start_post() {
    # Sucesso e' o controlador aparecer para o kernel, nao o processo existir.
    local i=0
    while [ ! -e /sys/class/bluetooth/hci0 ] && [ $i -lt 40 ]; do
        sleep 0.25
        i=$((i + 1))
    done
    ebegin "Aguardando hci0"
    [ -e /sys/class/bluetooth/hci0 ]
    eend $? "hci0 nao apareceu; ver $output_log"
}
